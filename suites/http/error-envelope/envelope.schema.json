{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui.particle.academy/schemas/fancy-error-envelope.schema.json",
  "title": "Fancy error envelope",
  "description": "The one error body every Fancy server emits (CC-fancy-0031). Normative text: fancy-conformance suites/http/SPEC.md section 1. Kept to type, required, properties, enum, pattern, items, minItems, minimum and additionalProperties so a small first-party validator can check it.",
  "type": "object",
  "required": ["error", "message", "requestId"],
  "properties": {
    "error": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "message": { "type": "string", "minLength": 1, "maxLength": 300 },
    "field": { "type": "string" },
    "limit": { "$ref": "#/$defs/limit" },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["error", "message"],
        "properties": {
          "error": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "message": { "type": "string", "minLength": 1, "maxLength": 300 },
          "field": { "type": "string" },
          "limit": { "$ref": "#/$defs/limit" }
        },
        "additionalProperties": false
      }
    },
    "retryAfter": { "type": "integer", "minimum": 0 },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" }
  },
  "additionalProperties": false,
  "$defs": {
    "limit": {
      "type": "object",
      "required": ["name", "max"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
        "max": { "type": "integer", "minimum": 0 },
        "actual": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
