    {
      "id": "0008-invalid-content",
      "title": "Invalid content is refused with the validator's code and path",
      "since": "0.37.0",
      "tags": [
        "to-last-word"
      ],
      "fn": "fromPortable",
      "input": {
        "content": {
          "fancyContent": 1,
          "items": [
            {
              "type": "text",
              "role": "paragraph",
              "runs": [
                {
                  "text": "x",
                  "link": "file:///etc/passwd"
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "ok": false,
        "refused": {
          "reason": "content_invalid",
          "path": "/items/0/runs/0/link"
        }
      }
    },
    {
      "id": "0009-partial-widths",
      "title": "Widths only when every column has one",
      "since": "0.37.0",
      "tags": [
        "to-last-word"
      ],
      "fn": "fromPortable",
      "input": {
        "content": {
          "fancyContent": 1,
          "items": [
            {
              "type": "table",
              "columns": [
                {
                  "width": 1
                },
                {
                  "align": "left"
                }
              ],
              "rows": [
                {
                  "cells": [
                    {
                      "t": "string",
                      "v": "a"
                    },
                    {
                      "t": "string",
                      "v": "b"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "blocks": [
          {
            "type": "table",
            "rows": [
              {
                "cells": [
                  {
                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": [
                          {
                            "text": "a"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": [
                          {
                            "text": "b"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "report": {
          "dropped": [],
          "approximated": [],
          "guard": {
            "findings": []
          }
        }
      },
      "notes": "A column align does not become a paragraph align in this direction: the spec maps a cell's align only."
    },
    {
