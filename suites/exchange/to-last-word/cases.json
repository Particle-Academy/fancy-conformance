    {
      "id": "0006-cell-runs-and-empty",
      "title": "Cell runs are kept; an empty cell is a paragraph with no runs",
      "since": "0.37.0",
      "tags": [
        "to-last-word"
      ],
      "fn": "fromPortable",
      "input": {
        "content": {
          "fancyContent": 1,
          "items": [
            {
              "type": "table",
              "rows": [
                {
                  "cells": [
                    {
                      "t": "string",
                      "v": "ab",
                      "runs": [
                        {
                          "text": "a",
                          "bold": true
                        },
                        {
                          "text": "b"
                        }
                      ]
                    },
                    {
                      "t": "empty"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "blocks": [
          {
            "type": "table",
            "rows": [
              {
                "cells": [
                  {
                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": [
                          {
                            "text": "a",
                            "bold": true
                          },
                          {
                            "text": "b"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": []
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "report": {
          "dropped": [],
          "approximated": [],
          "guard": {
            "findings": []
          }
        }
      }
    },
    {
