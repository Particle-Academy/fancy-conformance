                "/items/0/rows/1/cells/1"
              ]
            }
          ],
          "guard": {
            "findings": []
          }
        }
      }
    },
    {
      "id": "0011-typed-values",
      "title": "bool, date, error and display text",
      "since": "0.37.0",
      "tags": [
        "to-last-word"
      ],
      "fn": "fromPortable",
      "input": {
        "content": {
          "fancyContent": 1,
          "items": [
            {
              "type": "table",
              "rows": [
                {
                  "cells": [
                    {
                      "t": "bool",
                      "v": false
                    },
                    {
                      "t": "date",
                      "v": "2026-10-27"
                    },
                    {
                      "t": "error",
                      "v": "#N/A"
                    },
                    {
                      "t": "string",
                      "v": "s"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "blocks": [
          {
            "type": "table",
            "rows": [
              {
                "cells": [
                  {
                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": [
                          {
                            "text": "FALSE"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": [
                          {
                            "text": "2026-10-27"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": [
                          {
                            "text": "#N/A"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": [
                          {
                            "text": "s"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "report": {
          "dropped": [],
          "approximated": [
            {
              "kind": "typed-as-text",
              "count": 3,
              "where": [
                "/items/0/rows/0/cells/0",
                "/items/0/rows/0/cells/1",
                "/items/0/rows/0/cells/2"
              ]
            }
          ],
          "guard": {
            "findings": []
          }
        }
      },
      "notes": "Not numeric columns: alignment is only for number cells."
    }
  ]
}
