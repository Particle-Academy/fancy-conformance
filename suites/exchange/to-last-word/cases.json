                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": [
                          {
                            "text": "1"
                          }
                        ],
                        "align": "center"
                      }
                    ]
                  }
                ]
              },
              {
                "cells": [
                  {
                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": [
                          {
                            "text": "2"
                          }
                        ],
                        "align": "right"
                      }
                    ]
                  }
                ]
              }
            ]
          }
