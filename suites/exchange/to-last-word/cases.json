    {
      "id": "0004-formula",
      "title": "A formula is never carried: the value is written",
      "since": "0.37.0",
      "tags": [
        "to-last-word"
      ],
      "fn": "fromPortable",
      "input": {
        "content": {
          "fancyContent": 1,
          "items": [
            {
              "type": "table",
              "rows": [
                {
                  "cells": [
                    {
                      "t": "number",
                      "v": 30,
                      "formula": "SUM(A1:A2)"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "blocks": [
          {
            "type": "table",
            "rows": [
              {
                "cells": [
                  {
                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": [
                          {
                            "text": "30"
                          }
                        ],
                        "align": "right"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "report": {
          "dropped": [],
          "approximated": [
            {
              "kind": "formula-as-value",
              "count": 1,
              "where": [
                "/items/0/rows/0/cells/0"
              ]
            },
            {
              "kind": "typed-as-text",
              "count": 1,
              "where": [
                "/items/0/rows/0/cells/0"
              ]
            }
          ],
          "guard": {
            "findings": []
          }
        }
      }
    },
    {
      "id": "0005-image",
