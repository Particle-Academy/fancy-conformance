{
  "$schema": "../../../schema/case-table.schema.json",
  "suite": "exchange/to-last-word",
  "cases": [
    {
      "id": "0001-text-and-list",
      "title": "Headings, paragraphs and lists map across",
      "since": "0.37.0",
      "tags": [
        "to-last-word"
      ],
      "fn": "fromPortable",
      "input": {
        "content": {
          "fancyContent": 1,
          "items": [
            {
              "type": "text",
              "role": "heading",
              "level": 2,
              "runs": [
                {
                  "text": "H"
                }
              ]
            },
            {
              "type": "text",
              "role": "paragraph",
              "runs": [
                {
                  "text": "a",
                  "bold": true
                },
                {
                  "text": "b",
                  "link": "https://example.com"
                }
              ]
            },
            {
              "type": "list",
              "items": [
                {
                  "runs": [
                    {
                      "text": "x"
                    }
                  ],
                  "children": [
                    {
                      "runs": [
                        {
                          "text": "y"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "blocks": [
          {
            "type": "heading",
            "level": 2,
            "runs": [
              {
                "text": "H"
              }
            ]
          },
          {
            "type": "paragraph",
            "runs": [
              {
                "text": "a",
                "bold": true
              },
              {
                "text": "b",
                "link": "https://example.com"
              }
            ]
          },
          {
            "type": "list",
            "ordered": false,
            "items": [
              {
                "runs": [
                  {
                    "text": "x"
                  }
                ],
                "children": [
                  {
                    "runs": [
                      {
                        "text": "y"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "report": {
          "dropped": [],
          "approximated": [],
          "guard": {
            "findings": []
          }
        }
      }
    },
    {
      "id": "0002-table-numeric-column",
      "title": "A numeric column is right-aligned, header included; typed cells become text",
      "since": "0.37.0",
      "tags": [
        "to-last-word"
      ],
      "fn": "fromPortable",
      "input": {
        "content": {
          "fancyContent": 1,
          "items": [
            {
              "type": "table",
              "headerRows": 1,
              "columns": [
                {
                  "width": 0.4
                },
                {
                  "width": 0.6
                }
              ],
              "rows": [
                {
                  "cells": [
                    {
                      "t": "string",
                      "v": "Item"
                    },
                    {
                      "t": "string",
                      "v": "Amount"
                    }
                  ]
                },
                {
                  "cells": [
                    {
                      "t": "string",
                      "v": "A"
                    },
                    {
                      "t": "number",
                      "v": 1234.5,
                      "format": {
                        "kind": "currency"
                      },
                      "text": "$1,234.50"
                    }
                  ]
                },
                {
                  "cells": [
                    {
                      "t": "string",
                      "v": "B"
                    },
                    {
                      "t": "empty"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "blocks": [
          {
            "type": "table",
            "widths": [
              0.4,
              0.6
            ],
            "rows": [
              {
                "header": true,
                "cells": [
                  {
                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": [
                          {
                            "text": "Item"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": [
                          {
                            "text": "Amount"
                          }
                        ],
                        "align": "right"
                      }
                    ]
                  }
                ]
              },
              {
                "cells": [
                  {
                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": [
                          {
                            "text": "A"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": [
                          {
                            "text": "$1,234.50"
                          }
                        ],
                        "align": "right"
                      }
                    ]
                  }
                ]
              },
              {
                "cells": [
                  {
                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": [
                          {
                            "text": "B"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": [],
                        "align": "right"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "report": {
          "dropped": [],
          "approximated": [
            {
              "kind": "typed-as-text",
              "count": 1,
              "where": [
                "/items/0/rows/1/cells/1"
              ]
            }
          ],
          "guard": {
            "findings": []
          }
        }
      },
      "notes": "Tabulator's rule: every non-empty BODY cell is a number, so the column is numeric, and alignment applies to every cell of it."
    },
