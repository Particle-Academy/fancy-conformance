                        ],
                        "align": "right"
                      }
                    ]
                  },
                  {
                    "blocks": [
                      {
                        "type": "paragraph",
                        "runs": [
                          {
                            "text": "2"
                          }
                        ],
                        "align": "right"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "report": {
          "dropped": [],
          "approximated": [
            {
              "kind": "typed-as-text",
              "count": 2,
              "where": [
