{
  "$schema": "../../../schema/case-table.schema.json",
  "suite": "exchange/csv",
  "cases": [
    {
      "id": "0001-simple",
      "title": "Every record ends in CRLF",
      "since": "0.37.0",
      "tags": [
        "csv"
      ],
      "fn": "toCsv",
      "input": {
        "table": {
          "type": "table",
          "headerRows": 1,
          "rows": [
            {
              "cells": [
                {
                  "t": "string",
                  "v": "a"
                },
                {
                  "t": "string",
                  "v": "b"
                }
              ]
            },
            {
              "cells": [
                {
                  "t": "number",
                  "v": 1
                },
                {
                  "t": "number",
                  "v": 2.5
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "text": "a,b\r\n1,2.5\r\n",
        "report": {
          "dropped": [],
          "approximated": [],
          "guard": {
            "findings": []
          }
        }
      }
    },
    {
      "id": "0002-quoting",
      "title": "Quote on comma, quote, LF and CR; double the quote",
      "since": "0.37.0",
      "tags": [
        "csv"
      ],
      "fn": "toCsv",
      "input": {
        "table": {
          "type": "table",
          "rows": [
            {
              "cells": [
                {
                  "t": "string",
                  "v": "a,b"
                },
                {
                  "t": "string",
                  "v": "say \"hi\""
                },
                {
                  "t": "string",
                  "v": "l1\nl2"
                },
                {
                  "t": "string",
                  "v": "c\r"
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "text": "\"a,b\",\"say \"\"hi\"\"\",\"l1\nl2\",\"c\r\"\r\n",
        "report": {
          "dropped": [],
          "approximated": [],
          "guard": {
            "findings": []
          }
        }
      }
    },
    {
      "id": "0003-formula-injection",
      "title": "= + - @ TAB CR are prefixed with ', on by default",
      "since": "0.37.0",
      "tags": [
        "csv"
      ],
      "fn": "toCsv",
      "input": {
        "table": {
          "type": "table",
          "rows": [
            {
              "cells": [
                {
                  "t": "string",
                  "v": "=SUM(A1)"
                },
                {
                  "t": "string",
                  "v": "+1"
                },
                {
                  "t": "string",
                  "v": "-x"
                },
                {
                  "t": "string",
                  "v": "@x"
                },
                {
                  "t": "string",
                  "v": "\tx"
                },
                {
                  "t": "string",
                  "v": "\rx"
                },
                {
                  "t": "string",
                  "v": "ok"
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "text": "'=SUM(A1),'+1,'-x,'@x,'\tx,\"'\rx\",ok\r\n",
        "report": {
          "dropped": [],
          "approximated": [
            {
              "kind": "csv-escaped",
              "count": 6,
              "where": [
                "/rows/0/cells/0",
                "/rows/0/cells/1",
                "/rows/0/cells/2",
                "/rows/0/cells/3",
                "/rows/0/cells/4",
                "/rows/0/cells/5"
              ]
            }
          ],
          "guard": {
            "findings": []
          }
        }
      },
      "notes": "Owner decision 6. The CR field is escaped, then quoted."
    },
    {
      "id": "0004-numbers-not-escaped",
      "title": "A negative number is a number, not a formula",
      "since": "0.37.0",
      "tags": [
        "csv"
      ],
      "fn": "toCsv",
      "input": {
        "table": {
          "type": "table",
          "rows": [
            {
              "cells": [
                {
                  "t": "number",
                  "v": -5
                },
                {
                  "t": "string",
                  "v": "-5"
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "text": "-5,'-5\r\n",
        "report": {
          "dropped": [],
          "approximated": [
            {
              "kind": "csv-escaped",
              "count": 1,
              "where": [
                "/rows/0/cells/1"
              ]
            }
          ],
          "guard": {
            "findings": []
          }
        }
      },
      "notes": "Escaping numbers would corrupt every negative figure in an export."
    },
    {
      "id": "0005-escaping-off",
      "title": "The host may turn escaping off",
      "since": "0.37.0",
      "tags": [
        "csv"
      ],
      "fn": "toCsv",
      "input": {
        "table": {
          "type": "table",
          "rows": [
            {
              "cells": [
                {
                  "t": "string",
                  "v": "=SUM(A1)"
                },
                {
                  "t": "string",
                  "v": "+1"
                },
                {
                  "t": "string",
                  "v": "-x"
                },
                {
                  "t": "string",
                  "v": "@x"
                },
                {
                  "t": "string",
                  "v": "\tx"
                },
                {
                  "t": "string",
                  "v": "\rx"
                },
                {
                  "t": "string",
                  "v": "ok"
                }
              ]
            }
          ]
        },
        "options": {
          "escapeFormulas": false
        }
      },
      "expected": {
        "text": "=SUM(A1),+1,-x,@x,\tx,\"\rx\",ok\r\n",
        "report": {
          "dropped": [],
          "approximated": [],
          "guard": {
            "findings": []
          }
        }
      }
    },
