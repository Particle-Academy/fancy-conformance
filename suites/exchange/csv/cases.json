    {
      "id": "0008-spans",
      "title": "A span writes empty fields in its covered slots",
      "since": "0.37.0",
      "tags": [
        "csv"
      ],
      "fn": "toCsv",
      "input": {
        "table": {
          "type": "table",
          "rows": [
            {
              "cells": [
                {
                  "t": "string",
                  "v": "wide",
                  "colSpan": 2,
                  "rowSpan": 2
                },
                {
                  "t": "string",
                  "v": "c"
                }
              ]
            },
            {
              "cells": [
                {
                  "t": "string",
                  "v": "d"
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "text": "wide,,c\r\n,,d\r\n",
        "report": {
          "dropped": [],
          "approximated": [
            {
              "kind": "merge-flattened",
              "count": 1,
              "where": [
                "/rows/0/cells/0"
              ]
            }
          ],
          "guard": {
            "findings": []
          }
        }
      }
    },
