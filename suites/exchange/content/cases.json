    {
      "id": "0016-runs-disagree-with-value",
      "title": "Runs must concatenate to the display string",
      "since": "0.37.0",
      "tags": [
        "content"
      ],
      "fn": "validateContent",
      "input": {
        "content": {
          "fancyContent": 1,
          "items": [
            {
              "type": "table",
              "rows": [
                {
                  "cells": [
                    {
                      "t": "string",
                      "v": "Revenue",
                      "runs": [
                        {
                          "text": "Rev"
                        },
                        {
                          "text": "enew"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "ok": false,
        "code": "content_invalid",
        "path": "/items/0/rows/0/cells/0/runs"
      },
      "notes": "Otherwise the runs can carry text the value does not, and a consumer reading v sees a different document from one reading runs."
    },
    {
      "id": "0017-bold-number-runs-on-display",
      "title": "Runs on a number concatenate to its display text",
      "since": "0.37.0",
      "tags": [
        "content"
      ],
      "fn": "validateContent",
      "input": {
        "content": {
          "fancyContent": 1,
          "items": [
            {
              "type": "table",
              "rows": [
                {
                  "cells": [
                    {
                      "t": "number",
                      "v": 1234.5,
                      "text": "$1,234.50",
                      "format": {
                        "kind": "currency"
                      },
                      "runs": [
                        {
                          "text": "$1,234.50",
                          "bold": true
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "ok": true
      },
      "notes": "SPEC 17.4: runs are allowed on any cell, so a bold figure stays bold."
    },
