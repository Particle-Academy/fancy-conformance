{
  "$schema": "../../../schema/case-table.schema.json",
  "suite": "exchange/content",
  "cases": [
    {
      "id": "0001-minimal-envelope",
      "title": "The smallest valid content: version and an empty item list",
      "since": "0.37.0",
      "tags": [
        "content"
      ],
      "fn": "validateContent",
      "input": {
        "content": {
          "fancyContent": 1,
          "items": []
        }
      },
      "expected": {
        "ok": true
      }
    },
    {
      "id": "0002-the-plan-example",
      "title": "The plan's section 3.1 example validates as written",
      "since": "0.37.0",
      "tags": [
        "content"
      ],
      "fn": "validateContent",
      "input": {
        "content": {
          "fancyContent": 1,
          "source": {
            "kind": "xlsx",
            "package": "holy-sheet",
            "version": "2.11.0",
            "selector": {
              "sheet": "Q4",
              "range": "A1:D20"
            },
            "sourceKind": "document"
          },
          "items": [
            {
              "type": "table",
              "caption": "Q4 revenue",
              "headerRows": 1,
              "columns": [
                {
                  "width": 0.3
                },
                {
                  "width": 0.7,
                  "align": "right"
                }
              ],
              "rows": [
                {
                  "cells": [
                    {
                      "t": "string",
                      "v": "Region"
                    },
                    {
                      "t": "string",
                      "v": "Revenue"
                    }
                  ]
                },
                {
                  "cells": [
                    {
                      "t": "string",
                      "v": "NA",
                      "runs": [
                        {
                          "text": "NA",
                          "bold": true
                        }
                      ]
                    },
                    {
                      "t": "number",
                      "v": 4820000,
                      "text": "$4,820,000.00",
                      "format": {
                        "kind": "currency",
                        "currency": "USD",
                        "decimals": 2
                      }
                    }
                  ]
                },
                {
                  "cells": [
                    {
                      "t": "string",
                      "v": "Total"
                    },
                    {
                      "t": "number",
                      "v": 12180000,
                      "text": "$12,180,000.00",
                      "formula": "SUM(B2:B4)"
                    }
                  ]
                },
                {
                  "cells": [
                    {
                      "t": "string",
                      "v": "Notes",
                      "colSpan": 2
                    }
                  ]
                }
              ]
            },
            {
              "type": "text",
              "role": "heading",
              "level": 2,
              "runs": [
                {
                  "text": "Method"
                }
              ]
            },
            {
              "type": "text",
              "role": "paragraph",
              "runs": [
                {
                  "text": "See ",
                  "italic": true
                },
                {
                  "text": "the site",
                  "link": "https://example.com"
                }
              ]
            },
            {
              "type": "list",
              "ordered": false,
              "items": [
                {
                  "runs": [
                    {
                      "text": "a"
                    }
                  ],
                  "children": []
                }
              ]
            },
            {
              "type": "image",
              "ref": "img1",
              "alt": "Logo",
              "widthPx": 240
            }
          ],
          "images": {
            "img1": {
              "mime": "image/png",
              "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGP4z8AAAAMBAQDJ/pLvAAAAAElFTkSuQmCC"
            }
          },
          "report": {
            "dropped": [
              {
                "kind": "chart",
                "count": 1
              }
            ],
            "approximated": [
              {
                "kind": "format-approximated",
                "count": 3
              }
            ],
            "guard": {
              "findings": [
                {
                  "rule": "invisible-chars",
                  "count": 2
                }
              ]
            }
          }
        }
      },
      "expected": {
        "ok": true
      },
      "notes": "Every key the plan shows is in the spec, including source.kind/version/sourceKind, a formula on a typed number, a bold run on a string and a colSpan of 2."
    },
    {
