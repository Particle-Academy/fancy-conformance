{
  "$schema": "../../../schema/case-table.schema.json",
  "suite": "exchange/policy",
  "cases": [
    {
      "id": "0001-null-policy",
      "title": "A null policy allows nothing",
      "since": "0.37.0",
      "tags": [
        "policy"
      ],
      "fn": "checkExport",
      "input": {
        "reader": "holy-sheet",
        "target": "csv",
        "policy": null,
        "environment": {
          "fine-print": true,
          "last-word": true
        }
      },
      "expected": {
        "ok": false,
        "refused": {
          "reason": "export_disabled",
          "target": "csv"
        }
      },
      "notes": "Owner decision 2: off for every target by default."
    },
    {
      "id": "0002-unsupported",
      "title": "holy-sheet has no pptx export",
      "since": "0.37.0",
      "tags": [
        "policy"
      ],
      "fn": "checkExport",
      "input": {
        "reader": "holy-sheet",
        "target": "pptx",
        "policy": {
          "allow": [
            "pptx"
          ]
        },
        "environment": {
          "fine-print": true,
          "last-word": true
        }
      },
      "expected": {
        "ok": false,
        "refused": {
          "reason": "export_unsupported",
          "target": "pptx"
        }
      }
    },
    {
      "id": "0003-unsupported-before-disabled",
      "title": "Unsupported is checked before disabled",
      "since": "0.37.0",
      "tags": [
        "policy"
      ],
      "fn": "checkExport",
      "input": {
        "reader": "holy-sheet",
        "target": "pptx",
        "policy": null,
        "environment": {
          "fine-print": true,
          "last-word": true
        }
      },
      "expected": {
        "ok": false,
        "refused": {
          "reason": "export_unsupported",
          "target": "pptx"
        }
      }
    },
    {
      "id": "0004-allowed",
      "title": "csv allowed and supported",
      "since": "0.37.0",
      "tags": [
        "policy"
      ],
      "fn": "checkExport",
      "input": {
        "reader": "holy-sheet",
        "target": "csv",
        "policy": {
          "allow": [
            "csv"
          ]
        },
        "environment": {
          "fine-print": true,
          "last-word": true
        }
      },
      "expected": {
        "ok": true
      }
    },
    {
      "id": "0005-pdf-module-absent",
      "title": "pdf allowed, fine-print not installed",
      "since": "0.37.0",
      "tags": [
        "policy"
      ],
      "fn": "checkExport",
      "input": {
        "reader": "holy-sheet",
        "target": "pdf",
        "policy": {
          "allow": [
            "pdf"
          ]
        },
        "environment": {
          "fine-print": false,
          "last-word": false
        }
      },
      "expected": {
        "ok": false,
        "refused": {
          "reason": "export_unavailable",
          "target": "pdf",
          "missing": "fine-print"
        }
      }
    },
    {
      "id": "0006-pdf-injected-absent",
      "title": "Injected absence beats a present module",
      "since": "0.37.0",
      "tags": [
        "policy"
      ],
      "fn": "checkExport",
      "input": {
        "reader": "last-word",
        "target": "pdf",
        "policy": {
          "allow": [
            "pdf"
          ],
          "modules": {
            "fine-print": false
          }
        },
        "environment": {
          "fine-print": true,
          "last-word": true
        }
      },
      "expected": {
        "ok": false,
        "refused": {
          "reason": "export_unavailable",
          "target": "pdf",
          "missing": "fine-print"
        }
      },
      "notes": "How every leg tests the absent case without uninstalling anything (plan section 6)."
    },
    {
      "id": "0007-input-refused",
      "title": "The input was refused: export_refused with the reader's code",
      "since": "0.37.0",
      "tags": [
        "policy"
      ],
      "fn": "checkExport",
      "input": {
        "reader": "holy-sheet",
        "target": "pdf",
        "policy": {
          "allow": [
            "pdf"
          ]
        },
        "environment": {
          "fine-print": true,
          "last-word": true
        },
        "inputRefused": "archive_too_large"
      },
      "expected": {
        "ok": false,
        "refused": {
          "reason": "export_refused",
          "target": "pdf",
          "cause": "archive_too_large"
        }
      }
    },
    {
      "id": "0008-disabled-before-unavailable",
      "title": "Disabled is checked before unavailable",
      "since": "0.37.0",
      "tags": [
        "policy"
      ],
      "fn": "checkExport",
      "input": {
        "reader": "holy-sheet",
        "target": "pdf",
        "policy": {
          "allow": [
            "csv"
          ]
        },
        "environment": {
          "fine-print": false,
          "last-word": false
        }
      },
      "expected": {
        "ok": false,
        "refused": {
          "reason": "export_disabled",
          "target": "pdf"
        }
      },
      "notes": "An agent learns nothing about what is installed from a disabled target."
    },
