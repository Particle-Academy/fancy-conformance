    {
      "id": "0012-agent-cannot-enable",
      "title": "allow in the agent's options throws; it never enables",
      "since": "0.37.0",
      "tags": [
        "policy"
      ],
      "fn": "checkExport",
      "input": {
        "reader": "holy-sheet",
        "target": "csv",
        "policy": null,
        "environment": {
          "fine-print": true,
          "last-word": true
        },
        "options": {
          "allow": [
            "csv"
          ]
        }
      },
      "expected": {
        "throws": "options_invalid"
      },
      "notes": "Plan section 5.2: host-held, never agent-supplied."
    },
    {
      "id": "0013-unknown-policy-key",
