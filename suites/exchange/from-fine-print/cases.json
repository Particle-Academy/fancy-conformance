      ],
      "fn": "toPortable",
      "input": {
        "model": {
          "ok": true,
          "pageCount": 2,
          "pages": [
            {
              "page": 1,
              "width": 612,
              "height": 792,
              "text": "\n \t\n"
            },
            {
              "page": 2,
              "width": 612,
              "height": 792,
              "text": "x"
            }
          ],
          "guard": {
            "policy": "redact",
