    },
    {
      "id": "0009-own-strip",
      "title": "The extract strips what the read left and adds it to the count",
      "since": "0.37.0",
      "tags": [
        "from-fine-print"
      ],
      "fn": "toPortable",
      "input": {
        "model": {
          "ok": true,
          "pageCount": 1,
          "pages": [
            {
              "page": 1,
              "width": 612,
              "height": 792,
              "text": "a​b"
            }
          ],
          "guard": {
            "policy": "redact",
            "threshold": "medium",
            "discarded": false,
            "findings": [
              {
                "rule": "invisible-chars",
                "severity": "low",
                "location": {
                  "source": "outline"
                }
              }
            ]
          }
        },
        "selector": null
      },
      "expected": {
        "ok": true,
        "content": {
          "fancyContent": 1,
          "source": {
            "package": "fine-print"
          },
          "report": {
            "dropped": [],
            "approximated": [
              {
                "kind": "structure-not-recovered",
                "count": 1,
                "where": [
                  "/pages/0"
                ]
              }
            ],
            "guard": {
              "findings": [
                {
                  "rule": "invisible-chars",
                  "count": 2
                }
              ]
            }
          },
          "items": [
            {
              "type": "text",
              "role": "paragraph",
              "runs": [
                {
                  "text": "ab"
                }
              ]
            }
          ]
        }
      },
      "notes": "A read under the flag policy leaves the characters in place; the extract still removes them."
    }
  ]
}
