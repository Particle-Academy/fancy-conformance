    {
      "id": "0103-currency-negative-eur",
      "title": "Minus before the symbol",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": -1234.5,
        "format": {
          "kind": "currency",
          "currency": "EUR"
        }
      },
      "expected": "-€1,234.50",
      "notes": "NumFmtBuilder writes -\"€\"#,##0.00."
    },
