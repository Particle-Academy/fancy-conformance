    {
      "id": "0305-number-with-date-kind",
      "title": "A number with a date kind is canonical",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": 45000,
        "format": {
          "kind": "date"
        }
      },
      "expected": "45000",
      "notes": "No serial-date conversion: the reader already turned serials into ISO strings."
    },
    {
      "id": "0306-date-with-number-kind",
      "title": "A date with a number kind is canonical",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "date",
        "v": "2026-10-27",
        "format": {
          "kind": "number"
        }
      },
      "expected": "2026-10-27"
    },
    {
      "id": "0401-no-format",
      "title": "No format: canonical",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": 1234.5
      },
      "expected": "1234.5"
    },
    {
      "id": "0402-no-format-float-noise",
      "title": "Canonical is shared/decimal formatFloat",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": 0.30000000000000004
      },
      "expected": "0.3",
      "notes": "formatFloat keeps 14 places: 0.3."
    },
