        "t": "date",
        "v": "2026-10-27",
        "format": {
          "kind": "date"
        }
      },
      "expected": "2026-10-27"
    },
    {
      "id": "0302-datetime",
      "title": "A datetime as a datetime",
      "since": "0.37.0",
