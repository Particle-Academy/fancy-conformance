{
  "$schema": "../../../schema/case-table.schema.json",
  "suite": "exchange/number-display",
  "cases": [
    {
      "id": "0001-number-two-places",
      "title": "Grouped, two places",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": 1234.5,
        "format": {
          "kind": "number",
          "decimals": 2
        }
      },
      "expected": "1,234.50"
    },
    {
      "id": "0002-number-default-zero-places",
      "title": "number defaults to 0 places, half away from zero",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": 1234.5,
        "format": {
          "kind": "number"
        }
      },
      "expected": "1,235",
      "notes": "NumFmtBuilder writes #,##0 when decimals is absent."
    },
    {
      "id": "0003-negative-half",
      "title": "-1234.5 at 0 places rounds away from zero",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": -1234.5,
        "format": {
          "kind": "number",
          "decimals": 0
        }
      },
      "expected": "-1,235",
      "notes": "Math.round gives -1234."
    },
    {
      "id": "0004-1-005",
      "title": "1.005 at 2 places is 1.01",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": 1.005,
        "format": {
          "kind": "number",
          "decimals": 2
        }
      },
      "expected": "1.01",
      "notes": "The double is 1.00499999999999989...; a binary toFixed gives 1.00. The spec rounds the shortest decimal, which is what PHP's number_format gives."
    },
    {
      "id": "0005-2-675",
      "title": "2.675 at 2 places is 2.68",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": 2.675,
        "format": {
          "kind": "number",
          "decimals": 2
        }
      },
      "expected": "2.68",
      "notes": "toFixed gives 2.67."
    },
    {
      "id": "0006-half-to-one",
      "title": "0.5 at 0 places is 1",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": 0.5,
        "format": {
          "kind": "number"
        }
      },
      "expected": "1",
      "notes": "Half-even gives 0."
    },
    {
      "id": "0007-negative-half-to-one",
      "title": "-0.5 at 0 places is -1",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": -0.5,
        "format": {
          "kind": "number"
        }
      },
      "expected": "-1"
    },
    {
      "id": "0008-two-and-a-half",
      "title": "2.5 at 0 places is 3",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": 2.5,
        "format": {
          "kind": "number"
        }
      },
      "expected": "3",
      "notes": "Half-even gives 2."
    },
    {
      "id": "0009-negative-rounds-to-zero",
      "title": "-0.004 at 2 places has no minus sign",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": -0.004,
        "format": {
          "kind": "number",
          "decimals": 2
        }
      },
      "expected": "0.00",
      "notes": "SPEC 6.2 step 4."
    },
    {
      "id": "0010-carry-through-grouping",
      "title": "999999.995 carries into a new group",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": 999999.995,
        "format": {
          "kind": "number",
          "decimals": 2
        }
      },
      "expected": "1,000,000.00"
    },
    {
      "id": "0011-1e21",
      "title": "1e21 is written out, never in exponent form",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": 1e+21,
        "format": {
          "kind": "number"
        }
      },
      "expected": "1,000,000,000,000,000,000,000",
      "notes": "String(1e21) is '1e+21'."
    },
    {
      "id": "0012-tiny-to-zero",
      "title": "1.5e-7 at 2 places",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": 1.5e-07,
        "format": {
          "kind": "number",
          "decimals": 2
        }
      },
      "expected": "0.00"
    },
    {
      "id": "0013-tiny-ten-places",
      "title": "1.5e-7 at 10 places",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": 1.5e-07,
        "format": {
          "kind": "number",
          "decimals": 10
        }
      },
      "expected": "0.0000001500",
      "notes": "String(1.5e-7) is '1.5e-7'."
    },
    {
      "id": "0014-three-places-padded",
      "title": "Padding to 3 places",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
