    {
      "id": "0203-percent-no-float-multiply",
      "title": "0.145 at 0 places is 15%",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": 0.145,
        "format": {
          "kind": "percent",
          "decimals": 0
        }
      },
      "expected": "15%",
      "notes": "0.145 * 100 is 14.499999999999998 in binary, which rounds to 14%. SPEC 6.2 step 2 moves the decimal point."
    },
    {
      "id": "0204-percent-not-grouped",
      "title": "Percent is not grouped",
      "since": "0.37.0",
      "tags": [
        "number-display"
      ],
      "fn": "display",
      "input": {
        "t": "number",
        "v": 12.345,
        "format": {
          "kind": "percent",
          "decimals": 0
        }
      },
      "expected": "1235%",
      "notes": "NumFmtBuilder writes 0%, with no #,##."
    },
    {
      "id": "0205-percent-negative-half",
