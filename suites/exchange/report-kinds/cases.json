    {
      "id": "0201-merge",
      "title": "Counts add, where lists concatenate a then b, entries stay sorted",
      "since": "0.37.0",
      "tags": [
        "report-kinds"
      ],
      "fn": "mergeReports",
      "input": {
        "a": {
          "dropped": [
            {
              "kind": "chart",
              "count": 1,
              "where": [
                "/a/0"
              ]
            }
          ],
          "approximated": [
            {
              "kind": "typed-as-text",
              "count": 2,
              "where": [
                "/a/1",
                "/a/2"
              ]
            }
          ],
          "guard": {
            "findings": [
              {
                "rule": "invisible-chars",
                "count": 1
              }
            ]
          }
        },
        "b": {
          "dropped": [
            {
              "kind": "chart",
              "count": 2,
              "where": [
                "/b/0",
                "/b/1"
              ]
            },
            {
              "kind": "comment",
              "count": 1,
              "where": [
                "/b/2"
              ]
            }
          ],
          "approximated": [],
          "guard": {
            "findings": [
              {
                "rule": "hidden-text",
                "count": 1
              },
              {
                "rule": "invisible-chars",
                "count": 3
              }
            ]
          }
        }
      },
      "expected": {
        "dropped": [
          {
            "kind": "chart",
            "count": 3,
            "where": [
              "/a/0",
              "/b/0",
              "/b/1"
            ]
          },
          {
            "kind": "comment",
            "count": 1,
            "where": [
              "/b/2"
            ]
          }
        ],
        "approximated": [
          {
            "kind": "typed-as-text",
            "count": 2,
            "where": [
              "/a/1",
              "/a/2"
            ]
          }
        ],
        "guard": {
          "findings": [
            {
              "rule": "hidden-text",
              "count": 1
            },
            {
              "rule": "invisible-chars",
              "count": 4
            }
          ]
        }
      },
      "notes": "This is how an export joins its reader's report to fine-print's repair notes."
    },
