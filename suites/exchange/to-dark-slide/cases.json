    {
      "id": "0012-capacity-needs-the-epsilon",
      "title": "A third of a 0.6 frame holds 4 rows, although third x 20 is 3.9999999999999996",
      "since": "0.37.0",
      "tags": [
        "to-dark-slide"
      ],
      "fn": "fromPortable",
      "input": {
        "element": {
          "id": "p1",
          "x": 0.1,
          "y": 0.2,
          "w": 0.8,
          "h": 0.6,
          "content": {
            "fancyContent": 1,
            "items": [
              {
                "type": "table",
                "headerRows": 1,
                "rows": [
                  {
                    "cells": [
                      {
                        "t": "string",
                        "v": "r0"
                      }
                    ]
                  },
                  {
                    "cells": [
                      {
                        "t": "string",
                        "v": "r1"
                      }
                    ]
                  },
                  {
                    "cells": [
                      {
                        "t": "string",
                        "v": "r2"
                      }
                    ]
                  },
                  {
                    "cells": [
                      {
                        "t": "string",
                        "v": "r3"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "text",
                "role": "paragraph",
                "runs": [
                  {
                    "text": "b"
                  }
                ]
              },
              {
                "type": "text",
                "role": "paragraph",
                "runs": [
                  {
                    "text": "c"
                  }
                ]
              }
            ]
          }
        }
      },
      "expected": {
        "ok": true,
        "elements": [
          {
            "id": "p1-0",
            "type": "table",
            "x": 0.1,
            "y": 0.2,
            "w": 0.8,
            "h": 0.19999999999999998,
            "columns": [
              {
                "key": "col1",
                "label": "r0"
              }
            ],
            "rows": [
              {
                "col1": "r1"
              },
              {
                "col1": "r2"
              },
              {
                "col1": "r3"
              }
            ]
          },
          {
            "id": "p1-1",
            "type": "text",
            "x": 0.1,
            "y": 0.4,
            "w": 0.8,
            "h": 0.19999999999999998,
            "format": "plain",
            "content": "b"
          },
          {
            "id": "p1-2",
            "type": "text",
            "x": 0.1,
            "y": 0.6,
            "w": 0.8,
            "h": 0.19999999999999998,
            "format": "plain",
            "content": "c"
          }
        ],
        "report": {
          "dropped": [],
          "approximated": [],
          "guard": {
            "findings": []
          }
        }
      },
      "notes": "0.6 / 3 is 0.19999999999999998 in binary, so a floor without the 1e-9 gives 3 and reports a clip that is not there."
    },
    {
