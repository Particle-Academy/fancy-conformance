    {
      "id": "0006-two-items-share-the-frame",
      "title": "Two items split the frame top to bottom; run styles are dropped in plain text",
      "since": "0.37.0",
      "tags": [
        "to-dark-slide"
      ],
      "fn": "fromPortable",
      "input": {
        "element": {
          "id": "p1",
          "x": 0.1,
          "y": 0.2,
          "w": 0.8,
          "h": 0.6,
          "content": {
            "fancyContent": 1,
            "items": [
              {
                "type": "text",
                "role": "heading",
                "level": 1,
                "runs": [
                  {
                    "text": "Title"
                  }
                ]
              },
              {
                "type": "text",
                "role": "paragraph",
                "runs": [
                  {
                    "text": "a ",
                    "bold": true
                  },
                  {
                    "text": "b"
                  }
                ]
              }
            ]
          }
        }
      },
      "expected": {
        "ok": true,
        "elements": [
          {
            "id": "p1-0",
            "type": "text",
            "x": 0.1,
            "y": 0.2,
            "w": 0.8,
            "h": 0.3,
            "format": "plain",
            "content": "Title"
          },
          {
            "id": "p1-1",
            "type": "text",
            "x": 0.1,
            "y": 0.5,
            "w": 0.8,
            "h": 0.3,
            "format": "plain",
            "content": "a b"
          }
        ],
        "report": {
          "dropped": [
            {
              "kind": "run-style-dropped",
              "count": 1,
              "where": [
                "/items/1"
              ]
            }
          ],
          "approximated": [],
          "guard": {
            "findings": []
          }
        }
      },
      "notes": "y + i * (h / n), computed in that order (SPEC 11.3)."
    },
