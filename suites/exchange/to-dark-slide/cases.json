{
  "$schema": "../../../schema/case-table.schema.json",
  "suite": "exchange/to-dark-slide",
  "cases": [
    {
      "id": "0001-table",
      "title": "Columns col1..colN, labels from the header row, display strings in the body",
      "since": "0.37.0",
      "tags": [
        "to-dark-slide"
      ],
      "fn": "fromPortable",
      "input": {
        "element": {
          "id": "p1",
          "x": 0.1,
          "y": 0.2,
          "w": 0.8,
          "h": 0.6,
          "content": {
            "fancyContent": 1,
            "items": [
              {
                "type": "table",
                "headerRows": 1,
                "columns": [
                  {
                    "width": 0.3
                  },
                  {
                    "width": 0.7,
                    "align": "right"
                  }
                ],
                "rows": [
                  {
                    "cells": [
                      {
                        "t": "string",
                        "v": "Plan"
                      },
                      {
                        "t": "string",
                        "v": "Price"
                      }
                    ]
                  },
                  {
                    "cells": [
                      {
                        "t": "string",
                        "v": "Starter"
                      },
                      {
                        "t": "number",
                        "v": 49,
                        "format": {
                          "kind": "currency"
                        },
                        "text": "$49.00"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "expected": {
        "ok": true,
        "elements": [
          {
            "id": "p1-0",
            "type": "table",
            "x": 0.1,
            "y": 0.2,
            "w": 0.8,
            "h": 0.6,
            "columns": [
              {
                "key": "col1",
                "label": "Plan",
                "width": 0.3
              },
              {
                "key": "col2",
                "label": "Price",
                "width": 0.7,
                "align": "right"
              }
            ],
            "rows": [
              {
                "col1": "Starter",
                "col2": "$49.00"
              }
            ]
          }
        ],
        "report": {
          "dropped": [],
          "approximated": [
            {
              "kind": "typed-as-text",
              "count": 1,
              "where": [
                "/items/0/rows/1/cells/1"
              ]
            }
          ],
          "guard": {
            "findings": []
          }
        }
      }
    },
