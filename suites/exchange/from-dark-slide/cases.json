                  "id": "tb",
                  "type": "table",
                  "x": 0.1,
                  "y": 0.1,
                  "w": 0.8,
                  "h": 0.6,
                  "columns": [
                    {
                      "key": "plan",
                      "label": "Plan",
                      "width": 0.25
                    },
                    {
                      "key": "price",
                      "align": "right"
                    }
                  ],
                  "rows": [
                    {
                      "plan": "Starter",
                      "price": 49
                    },
                    {
                      "plan": null,
                      "price": true
                    }
                  ]
                }
              ]
            }
          ]
        },
        "selector": null
      },
      "expected": {
        "ok": true,
        "content": {
          "fancyContent": 1,
          "source": {
            "package": "dark-slide"
          },
          "report": {
            "dropped": [],
            "approximated": [
              {
                "kind": "layout-not-preserved",
                "count": 1,
                "where": [
                  "/slides/0/elements/0"
                ]
              }
            ],
            "guard": {
              "findings": []
            }
          },
          "items": [
            {
              "type": "table",
              "headerRows": 1,
              "columns": [
                {
                  "width": 0.25
                },
                {
                  "width": 0.75,
                  "align": "right"
                }
              ],
              "rows": [
                {
                  "cells": [
                    {
                      "t": "string",
                      "v": "Plan"
                    },
                    {
                      "t": "string",
                      "v": "price"
                    }
                  ]
                },
                {
                  "cells": [
                    {
                      "t": "string",
                      "v": "Starter"
                    },
                    {
                      "t": "number",
                      "v": 49
                    }
                  ]
                },
                {
                  "cells": [
                    {
                      "t": "empty"
                    },
                    {
                      "t": "bool",
                      "v": true
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "notes": "price has no label: the key is the header text."
    },
