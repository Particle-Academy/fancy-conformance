  "cases": [
    {
      "id": "0001-plain-text",
      "title": "Plain text: paragraphs on blank lines, CRLF normalised",
      "since": "0.37.0",
      "tags": [
        "from-dark-slide"
      ],
      "fn": "toPortable",
      "input": {
        "model": {
          "title": "Deck",
          "slides": [
            {
              "id": "s1",
              "elements": [
                {
                  "id": "t1",
                  "type": "text",
                  "x": 0.1,
                  "y": 0.1,
                  "w": 0.8,
                  "h": 0.6,
                  "content": "Line one\r\nline two\n  \nNext",
                  "format": "plain"
                }
              ]
            }
          ]
        },
        "selector": null
      },
      "expected": {
        "ok": true,
        "content": {
          "fancyContent": 1,
          "source": {
            "package": "dark-slide"
          },
          "report": {
            "dropped": [],
            "approximated": [
              {
                "kind": "layout-not-preserved",
                "count": 1,
                "where": [
                  "/slides/0/elements/0"
                ]
              }
            ],
            "guard": {
              "findings": []
            }
          },
          "items": [
            {
              "type": "text",
              "role": "paragraph",
              "runs": [
                {
                  "text": "Line one\nline two"
                }
              ]
            },
            {
              "type": "text",
              "role": "paragraph",
              "runs": [
                {
                  "text": "Next"
                }
              ]
            }
          ]
        }
      },
      "notes": "A line of two spaces is blank (SPEC 10, paragraph split)."
    },
