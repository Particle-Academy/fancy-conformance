      "notes": "Agreed name: inFront (Fancy's decision when the anchor model was accepted). behind and inFront are the two wrapNone cases."
    },
    {
      "id": "0108-anchor-horizontal-offset",
      "title": "anchor.horizontal.offset is points, at most 22in either way",
      "since": "0.63.0",
      "tags": [
        "shared"
      ],
      "fn": "constraint",
      "input": {
        "def": "anchor.horizontal.offset"
      },
      "expected": {
        "lastWord": {
          "type": "number",
          "minimum": -1584,
          "maximum": 1584
        },
        "finePrint": {}
      },
      "notes": "Agreed unit: points for offsets, px for size. 1584pt is 22in, the same bound as the 2112px size cap (0114)."
    },
