      },
      "expected": {
        "both": [
          "color",
          "inset",
          "style",
          "width"
        ],
        "lastWordOnly": [],
        "finePrintOnly": []
      },
      "notes": "Absent from last-word today, so its field set is empty there and this row fails with 0002."
    },
    {
      "id": "0004-band",
      "title": "Running header and footer",
