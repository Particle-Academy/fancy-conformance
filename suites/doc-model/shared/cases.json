          "cellPadding",
          "rows",
          "type",
          "width",
          "widths"
        ],
        "lastWordOnly": [],
        "finePrintOnly": [
          "keepNext"
        ]
      },
      "notes": "Deliberate delta until DOCX stage 2: fine-print keeps a table with the next block. Word has no table-level keepNext; last-word would have to set it on every paragraph of the last row."
