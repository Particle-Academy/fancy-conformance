          "runs",
          "shading",
          "spaceAfter",
          "spaceBefore",
          "type"
        ],
        "lastWordOnly": [
          "revision"
        ],
        "finePrintOnly": []
      },
      "notes": "Deliberate delta: last-word paragraphs carry revision (a tracked change on the paragraph mark, from its tracked-changes release). fine-print does not render revisions: it refuses one with revision_unsupported, or accepts it in validateAndRepair."
    },
