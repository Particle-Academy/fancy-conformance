{
  "$schema": "../../../schema/case-table.schema.json",
  "suite": "doc-model/shared",
  "cases": [
    {
      "id": "0001-document",
      "title": "Document properties",
      "since": "0.37.0",
      "tags": [
        "shared"
      ],
      "fn": "compare",
      "input": {
        "def": "document"
      },
      "expected": {
        "both": [
          "blocks",
          "defaultFont",
          "defaultSize",
          "meta",
          "page",
          "title"
        ],
        "lastWordOnly": [
          "comments"
        ],
        "finePrintOnly": []
      },
      "notes": "Deliberate delta: last-word documents carry top-level review comments (Word comments, from its comments release); fine-print has none yet. meta ({author}) is SHARED since fine-print's mixed-pages release: it writes the PDF's Author and an {author} band token from it."
    },
    {
      "id": "0002-page",
      "title": "page: background and border are SHARED",
      "since": "0.37.0",
      "tags": [
        "shared"
      ],
      "fn": "compare",
      "input": {
        "def": "page"
      },
      "expected": {
        "both": [
          "background",
          "border",
          "evenFooter",
          "evenHeader",
          "firstFooter",
          "firstHeader",
          "footer",
          "header",
          "margins",
          "orientation",
          "size"
        ],
        "lastWordOnly": [
          "columns"
        ],
        "finePrintOnly": []
      },
      "notes": "Deliberate delta: last-word pages carry text columns (from its columns release); fine-print draws one column. Owner decision 11: last-word gains page.background and page.border. This row FAILS for last-word until it does; that is the point. First-page and even-page bands are SHARED since fine-print's mixed-pages release."
    },
    {
      "id": "0003-page-border",
      "title": "The page frame's properties",
      "since": "0.37.0",
      "tags": [
        "shared"
      ],
      "fn": "compare",
