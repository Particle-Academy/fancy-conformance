    {
      "id": "0101-run-link",
      "title": "run.link: any string in last-word, http/https/mailto in fine-print",
      "since": "0.37.0",
      "tags": [
        "shared"
      ],
      "fn": "constraint",
      "input": {
        "def": "run.link"
      },
      "expected": {
        "lastWord": {
          "type": "string"
        },
        "finePrint": {
          "type": "string",
          "pattern": "^(https?://|mailto:)"
        }
      },
      "notes": "Deliberate delta: a PDF link is an action. Portable content uses the stricter rule both ways."
    },
    {
      "id": "0102-run-size",
      "title": "run.size: fine-print refuses text under 1pt",
      "since": "0.37.0",
      "tags": [
        "shared"
      ],
      "fn": "constraint",
      "input": {
        "def": "run.size"
      },
      "expected": {
        "lastWord": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "finePrint": {
          "type": "number",
          "minimum": 1,
          "maximum": 400
        }
      },
      "notes": "Not in the plan's list; found while writing this suite and pinned as deliberate (SPEC 17.16)."
    },
