          "left",
          "right",
          "size"
        ],
        "lastWordOnly": [],
        "finePrintOnly": []
      }
    },
    {
      "id": "0005-block-types",
      "title": "Block types: chart, columnBreak, shape and toc are last-word's alone",
      "since": "0.37.0",
      "tags": [
        "shared"
      ],
      "fn": "compare",
      "input": {
        "def": "blockTypes"
      },
      "expected": {
        "both": [
          "code",
          "heading",
          "hr",
          "image",
          "list",
          "pageBreak",
          "paragraph",
          "quote",
          "table"
        ],
        "lastWordOnly": [
          "chart",
          "columnBreak",
          "shape",
          "toc"
        ],
        "finePrintOnly": []
      },
      "notes": "Deliberate delta: fine-print draws no charts yet, has no table-of-contents field (last-word's toc block, from its bookmarks/fields release), draws one column (columnBreak, from its columns release), and has no shapes or text boxes (last-word's shape block, from its text boxes and shapes release). The shared renderer contract for a shape it cannot draw: draw its blocks as ordinary blocks and report shape; dropping the text is a bug."
    },
    {
      "id": "0006-run",
      "title": "Run properties",
      "since": "0.37.0",
      "tags": [
        "shared"
      ],
      "fn": "compare",
      "input": {
        "def": "run"
      },
      "expected": {
        "both": [
          "bold",
          "code",
          "color",
          "font",
          "footnote",
          "highlight",
          "italic",
          "letterSpacing",
          "link",
          "size",
          "smallCaps",
          "strike",
          "text",
          "underline"
        ],
        "lastWordOnly": [
          "bookmark",
          "comments",
          "field",
          "revision"
        ],
        "finePrintOnly": []
      },
      "notes": "Deliberate delta: last-word runs carry bookmark and field (Word bookmarks and body fields, from its bookmarks/fields release), comments (the ids of review comments anchored on the run, from its comments release) and revision (a tracked insertion or deletion, from its tracked-changes release); fine-print has none yet. fine-print does not render revisions: it refuses one with revision_unsupported, or accepts it in validateAndRepair. A run may carry a footnote ({text: \"\", footnote: {blocks}}). SHARED since fine-print's mixed-pages release, which draws it (owner: \"it should not be losing the footnote\")."
    },
