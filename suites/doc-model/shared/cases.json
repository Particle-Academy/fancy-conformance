      "fn": "constraint",
      "input": {
        "def": "page.size"
      },
      "expected": {
        "lastWord": {
          "enum": [
            "letter",
            "legal",
            "a4"
          ]
        },
        "finePrint": {
          "enum": [
            "letter",
