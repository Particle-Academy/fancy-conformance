            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "x"
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "finePrint": {
          "messages": [],
          "repairOk": true
        },
        "lastWord": {
          "messages": [
            "pageBreak.page is not implemented in last-word yet; remove page to keep one page setup, or write this document as a PDF with fine-print"
          ],
          "repairOk": false
        }
      }
    },
    {
      "id": "0003-trap-unrelated-repair",
      "title": "THE TRAP: an unrelated repair must not delete page and report ok",
      "since": "0.44.0",
      "tags": [
        "page-refusal"
      ],
      "fn": "refusal",
      "input": {
        "doc": {
          "blocks": [
            {
              "type": "heading",
              "runs": [
                {
                  "text": "no level"
                }
              ]
            },
            {
              "type": "pageBreak",
              "page": {
                "orientation": "landscape"
              }
            }
          ]
        }
      },
      "expected": {
        "finePrint": {
          "repairOk": true,
          "pageKept": true
        },
        "lastWord": {
          "repairOk": false
        }
      },
      "notes": "Before stage 1 the repairers rewrote a break to {type: pageBreak}, so repairing anything else silently undid the orientation and reported ok: true. Messages are not compared: the heading's own error differs by package."
    },
    {
      "id": "0004-trap-page-in-a-list-of-breaks",
      "title": "Every break is judged, not the first",
      "since": "0.44.0",
      "tags": [
        "page-refusal"
      ],
      "fn": "refusal",
      "input": {
        "doc": {
          "blocks": [
            {
              "type": "pageBreak"
            },
            {
              "type": "pageBreak",
              "page": {
                "orientation": "landscape"
              }
            },
            {
              "type": "pageBreak"
            },
            {
              "type": "pageBreak",
              "page": {
                "orientation": "landscape"
              }
            }
          ]
        }
      },
      "expected": {
        "finePrint": {
          "messages": [],
          "repairOk": true
        },
        "lastWord": {
          "messages": [
            "pageBreak.page is not implemented in last-word yet; remove page to keep one page setup, or write this document as a PDF with fine-print",
            "pageBreak.page is not implemented in last-word yet; remove page to keep one page setup, or write this document as a PDF with fine-print"
          ],
          "repairOk": false
        }
      }
    },
    {
      "id": "0010-near-miss-size",
      "title": "size on the break itself: the same message in both",
      "since": "0.44.0",
      "tags": [
        "page-refusal"
      ],
      "fn": "refusal",
      "input": {
        "doc": {
          "blocks": [
            {
              "type": "pageBreak",
              "size": "a4"
            }
          ]
        }
      },
      "expected": {
        "finePrint": {
          "messages": [
            "a pageBreak has no size key; use pageBreak.page"
          ],
          "repairOk": true
        },
        "lastWord": {
          "messages": [
            "a pageBreak has no size key; use pageBreak.page"
          ],
          "repairOk": false
        }
      },
      "notes": "fine-print's repair moves the key into page with a note (a background is then dropped, also with a note); last-word has nowhere to move it."
    },
