    {
      "id": "0030-sections",
      "title": "There is no sections key: refused by both, and repair cannot save it",
      "since": "0.44.0",
      "tags": [
        "page-refusal"
      ],
      "fn": "refusal",
      "input": {
        "doc": {
          "sections": [
            {
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "text": "x"
                    }
                  ]
                }
              ]
            }
          ],
          "blocks": []
        }
      },
      "expected": {
        "finePrint": {
          "messages": [
            "there is no sections key; use pageBreak.page"
          ],
          "repairOk": false
        },
        "lastWord": {
          "messages": [
            "there is no sections key; use pageBreak.page"
          ],
          "repairOk": false
        }
      },
      "notes": "Dropping it would lose the content inside it and report ok, so neither repairer does."
    },
