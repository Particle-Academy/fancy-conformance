{
  "$schema": "../../../schema/case-table.schema.json",
  "suite": "doc-model/page-refusal",
  "cases": [
    {
      "id": "0001-page",
      "title": "A break carrying page: fine-print honours it, last-word refuses",
      "since": "0.44.0",
      "tags": [
        "page-refusal"
      ],
      "fn": "refusal",
      "input": {
        "doc": {
          "blocks": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "x"
                }
              ]
            },
            {
              "type": "pageBreak",
              "page": {
                "orientation": "landscape"
              }
            },
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "x"
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "finePrint": {
          "messages": [],
          "repairOk": true
        },
        "lastWord": {
          "messages": [
            "pageBreak.page is not implemented in last-word yet; remove page to keep one page setup, or write this document as a PDF with fine-print"
          ],
          "repairOk": false
        }
      }
    },
    {
      "id": "0002-page-empty",
      "title": "An empty page is a request too",
      "since": "0.44.0",
      "tags": [
        "page-refusal"
