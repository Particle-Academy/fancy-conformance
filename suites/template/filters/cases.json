    {
      "id": "0011-number-rounds-in-decimal",
      "title": "2.675 rounds to 2.68, not 2.67",
      "since": "0.35.0",
      "tags": [
        "template",
        "filters"
      ],
      "fn": "render",
      "input": {
        "template": {
          "fancyTemplate": 1,
          "writer": "fine-print",
          "variables": {
            "v": {
              "type": "number"
            }
          },
          "document": {
            "blocks": [
              {
                "type": "paragraph",
                "runs": [
                  {
                    "text": "{{ v | number:2 }}"
                  }
                ]
              }
            ]
          }
        },
        "data": {
          "v": 2.675
        }
      },
      "expected": {
        "ok": true,
        "document": {
          "blocks": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "2.68"
                }
              ]
            }
          ]
        }
      },
      "notes": "The double nearest 2.675 is 2.67499999...; binary rounding (JavaScript's toFixed, PHP's round on the double) gives 2.67. The spec rounds the SHORTEST round-trip decimal, \"2.675\", which is what the author typed."
    },
