    {
      "id": "0007-upper-leaves-non-ascii",
      "title": "upper leaves non-ASCII characters as they are",
      "since": "0.35.0",
      "tags": [
        "template",
        "filters"
      ],
      "fn": "render",
      "input": {
        "template": {
          "fancyTemplate": 1,
          "writer": "fine-print",
          "variables": {
            "v": {
              "type": "string"
            }
          },
          "document": {
            "blocks": [
              {
                "type": "paragraph",
                "runs": [
                  {
                    "text": "{{ v | upper }}"
                  }
                ]
              }
            ]
          }
        },
        "data": {
          "v": "łukasz ß é"
        }
      },
      "expected": {
        "ok": true,
        "document": {
          "blocks": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "łUKASZ ß é"
                }
              ]
            }
          ]
        }
      },
      "notes": "ENGLISH ONLY in v1 (owner decision 4). Full Unicode case mapping differs between JavaScript, PHP and Python (ß, dotted I, final sigma), and PHP needs mbstring for it. Unchanged is wrong-looking but identical everywhere; a half-mapped string would be wrong AND different per runtime."
    },
