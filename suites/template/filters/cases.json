    {
      "id": "0001-default-when-absent",
      "title": "default replaces an absent value",
      "since": "0.35.0",
      "tags": [
        "template",
        "filters"
      ],
      "fn": "render",
      "input": {
        "template": {
          "fancyTemplate": 1,
          "writer": "fine-print",
          "variables": {
            "v": {
              "type": "string"
            }
          },
          "document": {
            "blocks": [
              {
                "type": "paragraph",
                "runs": [
                  {
                    "text": "{{ v | default:\"N/A\" }}"
                  }
                ]
              }
            ]
          }
        },
        "data": {}
      },
      "expected": {
        "ok": true,
        "document": {
          "blocks": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "N/A"
                }
              ]
            }
          ]
        }
      },
      "notes": ""
    },
