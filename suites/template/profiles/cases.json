{
  "$schema": "../../../schema/case-table.schema.json",
  "suite": "template/profiles",
  "cases": [
    {
      "id": "0001-fine-print-band-token",
      "title": "A token in a band slot renders; the template's own {page} stays",
      "since": "0.35.0",
      "tags": [
        "template",
        "profiles"
      ],
      "fn": "render",
      "input": {
        "template": {
          "fancyTemplate": 1,
          "writer": "fine-print",
          "variables": {
            "name": {
              "type": "string"
            },
            "logo": {
              "type": "image"
            },
            "url": {
              "type": "string"
            }
          },
          "document": {
            "blocks": [],
            "page": {
              "footer": {
                "left": "{{ name }}",
                "right": "Page {page} of {pages}"
              }
            }
          }
        },
        "data": {
          "name": "Ada"
        }
      },
      "expected": {
        "ok": true,
        "document": {
          "blocks": [],
          "page": {
            "footer": {
              "left": "Ada",
              "right": "Page {page} of {pages}"
            }
          }
        }
      },
      "notes": "{page} written by the template author is the writer's feature."
    },
    {
      "id": "0002-fine-print-band-value-with-page-is-refused",
      "title": "A band VALUE containing {page} is VALUE_PAGE_FIELD",
      "since": "0.35.0",
      "tags": [
        "template",
        "profiles"
      ],
      "fn": "render",
      "input": {
        "template": {
          "fancyTemplate": 1,
          "writer": "fine-print",
          "variables": {
            "name": {
              "type": "string"
            },
            "logo": {
              "type": "image"
            },
            "url": {
              "type": "string"
            }
          },
          "document": {
            "blocks": [],
            "page": {
              "footer": {
                "left": "{{ name }}"
              }
            }
          }
        },
        "data": {
          "name": "see {page}"
        }
      },
      "expected": {
        "ok": false,
        "code": "VALUE_PAGE_FIELD",
        "path": "/document/page/footer/left"
      },
      "notes": "THE NAMED {page} ROW. fine-print replaces {page} in band text with str_replace and has no escape for it, so a recipient named 'see {page}' would print a page number. A refusal is loud; any lookalike substitution prints a different character. The plan said 'escaped'; there is nothing to escape WITH, recorded in SPEC 9."
    },
    {
      "id": "0003-fine-print-band-value-with-pages",
      "title": "{pages} likewise",
      "since": "0.35.0",
      "tags": [
