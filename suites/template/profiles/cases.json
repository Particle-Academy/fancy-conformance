    {
      "id": "0006-fine-print-image-from-an-image-variable",
      "title": "An image src from a declared image variable renders the data URL",
      "since": "0.35.0",
      "tags": [
        "template",
        "profiles"
      ],
      "fn": "render",
      "input": {
        "template": {
          "fancyTemplate": 1,
          "writer": "fine-print",
          "variables": {
            "name": {
              "type": "string"
            },
            "logo": {
              "type": "image"
            },
            "url": {
              "type": "string"
            }
          },
          "document": {
            "blocks": [
              {
                "type": "image",
                "src": "{{ logo }}",
                "alt": "Logo of {{ name }}"
              }
            ]
          }
        },
        "data": {
          "name": "Acme",
          "logo": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGP4z8AAAAMBAQDJ/pLvAAAAAElFTkSuQmCC"
        }
      },
      "expected": {
        "ok": true,
        "document": {
          "blocks": [
            {
              "type": "image",
              "src": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGP4z8AAAAMBAQDJ/pLvAAAAAElFTkSuQmCC",
              "alt": "Logo of Acme"
            }
          ]
        }
      },
      "notes": "alt is a text field."
    },
