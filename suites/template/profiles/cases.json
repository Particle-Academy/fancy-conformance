      "title": "holy-sheet: a whole-token number, boolean or date stays as it is",
      "since": "0.35.0",
      "tags": [
        "template",
        "profiles"
      ],
      "fn": "render",
      "input": {
        "template": {
          "fancyTemplate": 1,
          "writer": "holy-sheet",
          "variables": {
            "s": {
              "type": "string"
            },
            "n": {
              "type": "number"
            },
            "b": {
              "type": "boolean"
            },
            "d": {
              "type": "date"
            }
          },
          "document": {
            "sheets": [
              {
                "name": "Data",
                "rows": [
                  [
                    "{{ n }}",
                    "{{ b }}",
                    "{{ d }}",
                    "{{ s }}"
                  ]
                ]
              }
            ]
          }
        },
        "data": {
          "n": 12.5,
          "b": true,
          "d": "2026-10-27",
          "s": "plain"
        }
      },
      "expected": {
        "ok": true,
        "document": {
          "sheets": [
            {
              "name": "Data",
              "rows": [
                [
                  12.5,
                  true,
                  "2026-10-27",
                  {
                    "value": "plain"
                  }
                ]
              ]
            }
          ]
        }
      },
      "notes": "A date is validated ISO, which cannot begin with =, so it stays bare and the column's date type formats it. EVERY string result is wrapped, not only those starting with =: a rule keyed on the first character is a rule someone will get wrong.",
