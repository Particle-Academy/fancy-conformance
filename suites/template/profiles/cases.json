      },
      "notes": ""
    },
    {
      "id": "0004-fine-print-link-is-forbidden",
      "title": "A token in a run's link is TOKEN_FORBIDDEN_FIELD",
      "since": "0.35.0",
      "tags": [
        "template",
        "profiles"
      ],
      "fn": "render",
      "input": {
        "template": {
          "fancyTemplate": 1,
          "writer": "fine-print",
          "variables": {
            "name": {
              "type": "string"
            },
            "logo": {
              "type": "image"
            },
            "url": {
              "type": "string"
            }
          },
          "document": {
            "blocks": [
              {
                "type": "paragraph",
                "runs": [
                  {
                    "text": "site",
                    "link": "{{ url }}"
                  }
                ]
              }
            ]
          }
        },
        "data": {
          "url": "javascript:alert(1)"
        }
      },
      "expected": {
        "ok": false,
        "code": "TOKEN_FORBIDDEN_FIELD",
        "path": "/document/blocks/0/runs/0/link"
      },
      "notes": "Links come from the template author, never from data (plan section 2)."
    },
