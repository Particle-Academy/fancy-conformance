    {
      "id": "0012-separator-pattern",
      "title": "Nested arrays let an element carry its own separator run",
      "since": "0.35.0",
      "tags": [
        "template",
        "directives"
      ],
      "fn": "render",
      "input": {
        "template": {
          "fancyTemplate": 1,
          "writer": "fine-print",
          "variables": {
            "people": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "required": true
                  },
                  "score": {
                    "type": "number"
                  }
                }
              }
            },
            "title": {
              "type": "string"
            },
            "showNotes": {
              "type": "boolean"
            }
          },
          "document": {
            "blocks": [
              {
                "$each": "people",
                "type": "paragraph",
                "runs": [
                  {
                    "$if": "!$first",
                    "text": ", "
                  },
                  {
                    "text": "{{ item.name }}"
                  }
                ]
              }
            ]
          }
        },
        "data": {
          "people": [
            {
              "name": "A"
            },
            {
              "name": "B"
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "document": {
          "blocks": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "A"
                }
              ]
            },
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": ", "
                },
                {
                  "text": "B"
                }
              ]
            }
          ]
        }
      },
      "notes": "$first is the INNERMOST loop's, and an inner array item with only $if is not a loop, so it reads the outer one."
    },
    {
      "id": "0013-each-over-a-nested-path",
      "title": "$each takes a dotted path",
      "since": "0.35.0",
      "tags": [
        "template",
        "directives"
      ],
      "fn": "render",
      "input": {
        "template": {
          "fancyTemplate": 1,
          "writer": "fine-print",
          "variables": {
            "program": {
              "type": "object",
              "properties": {
                "modules": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "document": {
            "blocks": [
              {
                "$each": "program.modules",
                "$as": "m",
                "type": "paragraph",
                "runs": [
                  {
                    "text": "{{ m }}"
                  }
                ]
              }
            ]
          }
        },
        "data": {
          "program": {
            "modules": [
              "Intro",
              "Gears"
            ]
          }
        }
      },
      "expected": {
