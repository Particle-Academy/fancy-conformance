{
  "$schema": "../../../schema/case-table.schema.json",
  "suite": "template/directives",
  "cases": [
    {
      "id": "0001-each-repeats-an-item",
      "title": "$each repeats an array item once per element, splicing in order",
      "since": "0.35.0",
      "tags": [
        "template",
        "directives"
      ],
      "fn": "render",
      "input": {
        "template": {
          "fancyTemplate": 1,
          "writer": "fine-print",
          "variables": {
            "people": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "required": true
                  },
                  "score": {
                    "type": "number"
                  }
                }
              }
            },
            "title": {
              "type": "string"
            },
            "showNotes": {
              "type": "boolean"
            }
          },
          "document": {
            "blocks": [
              {
                "type": "paragraph",
                "runs": [
                  {
                    "text": "Before"
                  }
                ]
              },
              {
                "$each": "people",
                "type": "paragraph",
                "runs": [
                  {
                    "text": "{{ item.name }}"
                  }
                ]
              },
              {
                "type": "paragraph",
                "runs": [
                  {
                    "text": "After"
                  }
                ]
              }
            ]
          }
        },
        "data": {
          "people": [
            {
              "name": "Ada",
              "score": 91
            },
            {
              "name": "Charles",
              "score": 42
            },
            {
              "name": "Mary",
              "score": 77
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "document": {
          "blocks": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "Before"
                }
              ]
            },
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "Ada"
                }
              ]
            },
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "Charles"
                }
              ]
            },
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "Mary"
                }
              ]
            },
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "After"
                }
              ]
            }
          ]
        }
      },
      "notes": "The default binding name is `item`."
    },
    {
      "id": "0002-as-index-first-last",
      "title": "$as names the binding; $index, $first and $last are available",
      "since": "0.35.0",
      "tags": [
        "template",
        "directives"
      ],
      "fn": "render",
      "input": {
        "template": {
          "fancyTemplate": 1,
          "writer": "fine-print",
          "variables": {
            "people": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "required": true
                  },
                  "score": {
                    "type": "number"
                  }
                }
              }
            },
            "title": {
              "type": "string"
            },
            "showNotes": {
              "type": "boolean"
            }
          },
          "document": {
            "blocks": [
              {
                "$each": "people",
                "$as": "p",
                "type": "paragraph",
                "runs": [
                  {
                    "text": "{{ $index }}:{{ p.name }}:{{ $first }}:{{ $last }}"
                  }
                ]
              }
            ]
          }
        },
        "data": {
          "people": [
            {
              "name": "Ada",
              "score": 91
            },
            {
              "name": "Charles",
              "score": 42
            },
            {
              "name": "Mary",
              "score": 77
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "document": {
          "blocks": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "0:Ada:true:false"
                }
              ]
            },
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "1:Charles:false:false"
                }
              ]
            },
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "2:Mary:false:true"
                }
              ]
            }
          ]
        }
      },
      "notes": "$index is 0-based."
    },
    {
      "id": "0003-if-keeps-and-drops",
      "title": "$if keeps an item when truthy and drops it when not, and is removed from the output",
      "since": "0.35.0",
      "tags": [
        "template",
        "directives"
      ],
      "fn": "render",
      "input": {
        "template": {
          "fancyTemplate": 1,
          "writer": "fine-print",
          "variables": {
            "people": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "required": true
                  },
                  "score": {
                    "type": "number"
                  }
                }
              }
            },
            "title": {
              "type": "string"
            },
            "showNotes": {
              "type": "boolean"
            }
          },
          "document": {
            "blocks": [
              {
                "$if": "title",
                "type": "heading",
                "level": 1,
                "runs": [
                  {
                    "text": "{{ title }}"
                  }
                ]
              },
              {
                "$if": "showNotes",
                "type": "paragraph",
                "runs": [
                  {
                    "text": "Notes"
                  }
                ]
              }
            ]
          }
        },
        "data": {
          "title": "Report",
          "showNotes": false
        }
      },
      "expected": {
        "ok": true,
        "document": {
          "blocks": [
            {
              "type": "heading",
              "level": 1,
              "runs": [
                {
                  "text": "Report"
                }
              ]
            }
          ]
        }
      },
      "notes": ""
    },
    {
