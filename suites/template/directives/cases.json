    {
      "id": "0007-if-on-an-absent-optional-is-false",
      "title": "$if on an absent optional variable drops the item, without an error",
      "since": "0.35.0",
      "tags": [
        "template",
        "directives"
      ],
      "fn": "render",
      "input": {
        "template": {
          "fancyTemplate": 1,
          "writer": "fine-print",
          "variables": {
            "people": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "required": true
                  },
                  "score": {
                    "type": "number"
                  }
                }
              }
            },
            "title": {
              "type": "string"
            },
            "showNotes": {
              "type": "boolean"
            }
          },
          "document": {
            "blocks": [
              {
                "$if": "title",
                "type": "paragraph",
                "runs": [
                  {
                    "text": "x"
                  }
                ]
              },
              {
                "type": "paragraph",
                "runs": [
                  {
                    "text": "kept"
                  }
                ]
              }
            ]
          }
        },
        "data": {}
      },
      "expected": {
        "ok": true,
        "document": {
          "blocks": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "kept"
                }
              ]
            }
          ]
        }
      },
      "notes": "fancy-expr's rule: an absent path is null, and null is falsy. A TOKEN reading an absent variable fails (resolve 0009); a CONDITION asking whether it is there must not."
    },
    {
      "id": "0008-each-over-an-absent-array-is-missing",
      "title": "$each over an absent optional array is TEMPLATE_MISSING",
      "since": "0.35.0",
      "tags": [
        "template",
        "directives"
      ],
      "fn": "render",
      "input": {
        "template": {
          "fancyTemplate": 1,
          "writer": "fine-print",
          "variables": {
            "people": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "required": true
                  },
                  "score": {
                    "type": "number"
                  }
                }
              }
            },
            "title": {
              "type": "string"
            },
            "showNotes": {
              "type": "boolean"
            }
          },
          "document": {
            "blocks": [
              {
                "$each": "people",
                "type": "paragraph",
                "runs": [
                  {
                    "text": "{{ item.name }}"
                  }
                ]
              }
            ]
          }
        },
        "data": {}
      },
      "expected": {
        "ok": false,
        "code": "TEMPLATE_MISSING",
        "path": "/document/blocks/0/$each"
      },
      "notes": "Rendering nothing would be the silent-empty outcome the plan refuses. A template that may have no rows says so with `$if: \"people\"` on a wrapper."
    },
