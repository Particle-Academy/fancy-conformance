    {
      "id": "0015-if-reads-item-and-variables",
      "title": "$if sees the loop binding and the declared variables together",
      "since": "0.35.0",
      "tags": [
        "template",
        "directives"
      ],
      "fn": "render",
      "input": {
        "template": {
          "fancyTemplate": 1,
          "writer": "fine-print",
          "variables": {
            "people": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "required": true
                  },
                  "score": {
                    "type": "number"
                  }
                }
              }
            },
            "title": {
              "type": "string"
            },
            "showNotes": {
              "type": "boolean"
            }
          },
          "document": {
            "blocks": [
              {
                "$each": "people",
                "$if": "item.name !== title",
                "type": "paragraph",
                "runs": [
                  {
                    "text": "{{ item.name }}"
                  }
                ]
              }
            ]
          }
        },
        "data": {
          "people": [
            {
              "name": "Ada",
              "score": 91
            },
            {
              "name": "Charles",
              "score": 42
            },
            {
              "name": "Mary",
              "score": 77
            }
          ],
          "title": "Charles"
        }
      },
      "expected": {
        "ok": true,
        "document": {
          "blocks": [
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "Ada"
                }
              ]
            },
            {
              "type": "paragraph",
              "runs": [
                {
                  "text": "Mary"
                }
              ]
            }
          ]
        }
      },
      "notes": ""
    }
