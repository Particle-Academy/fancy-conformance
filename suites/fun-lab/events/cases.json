{
    "$schema": "../../../schema/case-table.schema.json",
    "suite": "fun-lab/events",
    "cases": [
        {
            "id": "0001-xp-awarded-payload",
            "title": "xp.awarded carries the flat payload: ids, the metric's slug and name, the amount, the metric's new total and level, reason, source and occurred_at",
            "since": "0.50.0",
            "tags": [
                "xp.awarded",
                "control"
            ],
            "fn": "broadcasts",
            "input": {
                "clock": "2026-11-18T12:00:00+00:00",
                "subjects": {
                    "ada": "user"
                },
                "steps": [
                    {
                        "op": "setup",
                        "a": "gamed-metric",
                        "with": {
                            "slug": "combat-xp",
                            "name": "Combat XP"
                        }
                    },
                    {
                        "op": "setup",
                        "a": "metric-level",
                        "with": {
                            "metric": "combat-xp",
                            "level": 1,
                            "xp": 0
                        }
                    },
                    {
                        "op": "setup",
                        "a": "metric-level",
                        "with": {
                            "metric": "combat-xp",
                            "level": 2,
                            "xp": 100
                        }
                    },
                    {
                        "op": "award",
                        "metric": "combat-xp",
                        "to": "ada",
                        "amount": 5,
                        "reason": "first blood",
                        "source": "arena"
                    }
                ]
            },
            "expected": {
                "steps": [
                    {
                        "result": {
                            "id": 1
                        },
                        "broadcasts": []
                    },
                    {
                        "result": {
                            "id": 1
                        },
                        "broadcasts": []
                    },
                    {
                        "result": {
                            "id": 2
                        },
                        "broadcasts": []
                    },
                    {
                        "result": {
                            "total_xp": 5,
                            "current_level": 1
                        },
                        "broadcasts": [
                            {
                                "event": "xp.awarded",
                                "payload": {
                                    "id": 1,
                                    "profile_id": 1,
                                    "gamed_metric_id": 1,
                                    "gamed_metric_slug": "combat-xp",
                                    "gamed_metric_name": "Combat XP",
                                    "amount": 5,
                                    "total_xp": 5,
                                    "current_level": 1,
                                    "reason": "first blood",
                                    "source": "arena",
                                    "occurred_at": "2026-11-18T12:00:00+00:00"
                                }
                            }
                        ]
                    }
                ]
            },
            "notes": "The UI's feed reads gamed_metric_name. A raw event with the name nested under metric renders the label with its {metric} placeholder unfilled."
        },
