{
  "$schema": "../../../schema/case-table.schema.json",
  "suite": "flow/graph-runs",
  "cases": [
    {
      "id": "0001-manual-transform-output",
      "title": "Manual trigger seeds a payload; transform extracts a field; output captures it.",
      "since": "0.6.0",
      "tags": [
        "trigger",
        "logic",
        "output"
      ],
      "input": {
        "schema": {
          "$schema": "https://particle.academy/schemas/workflow/v1.json",
          "version": 1,
          "graph": {
            "nodes": [
              {
                "id": "t",
                "kind": "manual_trigger",
                "position": {
                  "x": 0,
                  "y": 0
                }
              },
              {
                "id": "tf",
                "kind": "transform",
                "position": {
                  "x": 1,
                  "y": 0
                },
                "config": {
                  "expression": "{{ $json.user.name }}"
                }
              },
              {
                "id": "o",
                "kind": "output",
                "position": {
                  "x": 2,
                  "y": 0
                }
              }
            ],
            "edges": [
              {
                "id": "e1",
                "source": "t",
                "target": "tf"
              },
              {
                "id": "e2",
                "source": "tf",
                "target": "o"
              }
            ]
          }
        },
        "initialInputs": {
          "t": {
            "user": {
              "name": "Ada"
            }
          }
        }
      },
      "expected": {
        "ok": true,
        "outputs": {
          "t": {
            "user": {
              "name": "Ada"
            }
          },
          "tf": "Ada",
          "o": "Ada"
        }
      }
    },
    {
      "id": "0002-webhook-branch-true-notify",
      "title": "Webhook payload branches true and notifies; the merge point is the output.",
      "since": "0.6.0",
      "tags": [
        "trigger",
        "branch",
        "merge",
        "human"
      ],
      "input": {
        "schema": {
          "$schema": "https://particle.academy/schemas/workflow/v1.json",
          "version": 1,
          "graph": {
            "nodes": [
              {
                "id": "wh",
                "kind": "webhook_trigger",
                "position": {
                  "x": 0,
                  "y": 0
                }
              },
              {
                "id": "br",
                "kind": "branch",
                "position": {
                  "x": 1,
                  "y": 0
                },
                "config": {
                  "condition": "{{ $json.vip }}"
                }
              },
              {
                "id": "nf",
                "kind": "notify",
                "position": {
                  "x": 2,
                  "y": 0
                },
                "config": {
                  "channel": "slack",
                  "to": "#vips",
                  "message": "VIP {{ $json.name }}"
                }
              },
              {
                "id": "o",
                "kind": "output",
                "position": {
                  "x": 3,
                  "y": 0
                }
              }
            ],
            "edges": [
              {
                "id": "e1",
                "source": "wh",
                "target": "br"
              },
              {
                "id": "e2",
                "source": "br",
                "target": "nf",
                "sourceHandle": "true"
              },
              {
                "id": "e3",
                "source": "nf",
                "target": "o"
              }
            ]
          }
        },
        "initialInputs": {
          "wh": {
            "payload": {
              "vip": true,
              "name": "Ada"
            }
          }
        }
      },
      "expected": {
        "ok": true,
        "outputs": {
          "wh": {
            "vip": true,
            "name": "Ada"
          },
          "br": {
            "branch": "true",
            "value": {
              "vip": true,
              "name": "Ada"
            }
          },
          "nf": {
            "sent": true,
            "channel": "slack",
            "to": "#vips",
            "message": "VIP Ada"
          },
          "o": {
            "sent": true,
            "channel": "slack",
            "to": "#vips",
            "message": "VIP Ada"
          }
        }
      }
    },
