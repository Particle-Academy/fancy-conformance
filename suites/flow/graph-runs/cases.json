    {
      "id": "0004-switch-case",
      "title": "Switch routes on a key to case_b.",
      "since": "0.6.0",
      "tags": [
        "branch",
        "ports"
      ],
      "input": {
        "schema": {
          "$schema": "https://particle.academy/schemas/workflow/v1.json",
          "version": 1,
          "graph": {
            "nodes": [
              {
                "id": "t",
                "kind": "manual_trigger",
                "position": {
                  "x": 0,
                  "y": 0
                }
              },
              {
                "id": "sw",
                "kind": "switch_case",
                "position": {
                  "x": 1,
                  "y": 0
                },
                "config": {
                  "value": "{{ $json.kind }}",
                  "cases": {
                    "a": "case_a",
                    "b": "case_b"
                  }
                }
              },
              {
                "id": "o",
                "kind": "output",
                "position": {
                  "x": 2,
                  "y": 0
                }
              }
            ],
            "edges": [
              {
                "id": "e1",
                "source": "t",
                "target": "sw"
              },
              {
                "id": "e2",
                "source": "sw",
                "target": "o",
                "sourceHandle": "case_b"
              }
            ]
          }
        },
        "initialInputs": {
          "t": {
            "kind": "b"
          }
        }
      },
      "expected": {
        "ok": true,
        "outputs": {
          "t": {
            "kind": "b"
          },
          "sw": {
            "__port": "case_b",
            "value": {
              "kind": "b"
            }
          },
          "o": {
            "kind": "b"
          }
        }
      }
    },
    {
      "id": "0005-merge-after-decision",
      "title": "A decision routes down one branch; the merge point still runs (#1).",
      "since": "0.6.0",
      "tags": [
        "branch",
        "merge",
        "hazard"
      ],
      "input": {
        "schema": {
          "$schema": "https://particle.academy/schemas/workflow/v1.json",
          "version": 1,
          "graph": {
            "nodes": [
              {
                "id": "t",
                "kind": "manual_trigger",
                "position": {
                  "x": 0,
                  "y": 0
                }
              },
              {
                "id": "br",
                "kind": "branch",
                "position": {
                  "x": 1,
                  "y": 0
                },
                "config": {
                  "condition": "{{ $json.ok }}"
                }
              },
              {
                "id": "a",
                "kind": "transform",
                "position": {
                  "x": 2,
                  "y": 0
                },
                "config": {
                  "expression": "A"
                }
              },
              {
                "id": "b",
                "kind": "transform",
                "position": {
                  "x": 2,
                  "y": 1
                },
                "config": {
                  "expression": "B"
                }
              },
              {
                "id": "m",
                "kind": "merge",
                "position": {
                  "x": 3,
                  "y": 0
                },
                "config": {
                  "mode": "merge"
                }
              },
              {
                "id": "o",
                "kind": "output",
                "position": {
                  "x": 4,
                  "y": 0
                }
              }
            ],
            "edges": [
              {
                "id": "e1",
                "source": "t",
                "target": "br"
              },
              {
                "id": "e2",
                "source": "br",
                "target": "a",
                "sourceHandle": "true"
              },
              {
                "id": "e3",
                "source": "br",
                "target": "b",
                "sourceHandle": "false"
              },
              {
                "id": "e4",
                "source": "a",
                "target": "m",
                "targetHandle": "a"
              },
              {
                "id": "e5",
                "source": "b",
                "target": "m",
                "targetHandle": "b"
              },
              {
                "id": "e6",
                "source": "m",
                "target": "o"
              }
            ]
          }
        },
        "initialInputs": {
          "t": {
            "ok": true
          }
        }
      },
      "expected": {
        "ok": true,
        "outputs": {
          "t": {
            "ok": true
          },
          "br": {
            "branch": "true",
            "value": {
              "ok": true
            }
          },
          "a": "A",
          "m": {
            "a": "A"
          },
          "o": {
            "a": "A"
          }
        }
      },
      "notes": "The merge-after-decision case (#1). A node runs when AT LEAST ONE incoming edge is active, never when all are: a Decision leaves the untaken branch's edge dead forever, so an `every`-style check skips the shared continuation and halts the run after the first branch. An implementation requiring all incoming edges fails exactly this case and 0002."
    },
    {
      "id": "0006-merge-concat",
      "title": "Two lists concatenated.",
      "since": "0.6.0",
      "tags": [
        "merge"
      ],
      "input": {
        "schema": {
          "$schema": "https://particle.academy/schemas/workflow/v1.json",
          "version": 1,
          "graph": {
            "nodes": [
              {
                "id": "a",
                "kind": "variable",
                "position": {
                  "x": 0,
                  "y": 0
                },
                "config": {
                  "name": "a",
                  "value": "{{ $json.left }}"
                }
              },
              {
                "id": "b",
                "kind": "variable",
                "position": {
                  "x": 0,
                  "y": 1
                },
                "config": {
                  "name": "b",
                  "value": "{{ $json.right }}"
                }
              },
              {
                "id": "m",
                "kind": "merge",
                "position": {
                  "x": 1,
                  "y": 0
                },
                "config": {
                  "mode": "concat"
                }
              }
            ],
            "edges": [
              {
                "id": "e1",
                "source": "a",
                "target": "m",
                "targetHandle": "a"
              },
              {
                "id": "e2",
                "source": "b",
                "target": "m",
                "targetHandle": "b"
              }
            ]
          }
        },
        "initialInputs": {
          "a": {
            "left": [
              1,
              2
            ]
          },
          "b": {
            "right": [
              3
            ]
          }
        }
      },
      "expected": {
        "ok": true,
        "outputs": {
          "a": [
            1,
            2
          ],
          "b": [
            3
          ],
          "m": [
            1,
            2,
            3
          ]
        }
      }
    },
