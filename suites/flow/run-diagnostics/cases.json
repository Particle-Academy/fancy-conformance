    {
      "id": "0006-switch-routes-on-an-unresolved-value",
      "title": "A switch_case whose value resolves to nothing warns that it fell to `default`, naming `value` as the config key.",
      "since": "0.24.0",
      "tags": [
        "routing",
        "switch_case",
        "warns"
      ],
      "input": {
        "schema": {
