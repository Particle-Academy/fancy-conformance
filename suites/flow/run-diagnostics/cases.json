    {
      "id": "0010-inverted-switch-cases-map",
      "title": "A switch_case whose cases map is inverted (port => value) warns once per edge naming a port the node can never publish.",
      "since": "0.24.0",
      "tags": [
        "undelivered-edge",
        "switch_case",
        "warns"
      ],
      "input": {
        "schema": {
          "$schema": "https://particle.academy/schemas/workflow/v1.json",
          "version": 1,
          "graph": {
            "nodes": [
              {
                "id": "t",
                "kind": "manual_trigger",
                "position": {
                  "x": 0,
                  "y": 0
                }
              },
              {
                "id": "s",
                "kind": "switch_case",
                "position": {
                  "x": 0,
                  "y": 0
                },
                "config": {
                  "value": "{{ $json.kind }}",
                  "cases": {
                    "case_a": "a",
                    "case_b": "b"
                  }
                }
              },
              {
                "id": "to_case_a",
                "kind": "log",
                "position": {
                  "x": 0,
                  "y": 0
                },
                "config": {
                  "message": "case_a"
                }
              },
              {
                "id": "to_case_b",
                "kind": "log",
