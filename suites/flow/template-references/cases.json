  "cases": [
    {
      "id": "0001-wrong-field-is-found",
      "title": "A template naming a field the upstream kind does not declare is found, with what it could have named.",
      "since": "0.46.0",
      "tags": [
        "finds",
        "static-shape"
      ],
      "input": {
        "schema": {
          "$schema": "https://particle.academy/schemas/workflow/v1.json",
          "version": 1,
          "graph": {
            "nodes": [
              {
                "id": "t",
                "kind": "manual_trigger",
                "position": {
                  "x": 0,
                  "y": 0
                },
                "config": {}
              },
              {
                "id": "a",
                "kind": "llm_call",
                "position": {
                  "x": 0,
                  "y": 0
                },
                "config": {
                  "model": "m",
                  "prompt": "x"
                }
              },
              {
                "id": "o",
                "kind": "log",
                "position": {
                  "x": 0,
                  "y": 0
                },
                "config": {
                  "message": "{{ in.txt }}"
                }
              }
            ],
            "edges": [
              {
                "id": "e0",
                "source": "t",
                "target": "a"
              },
              {
                "id": "e1",
                "source": "a",
                "target": "o"
              }
            ]
          }
        }
      },
      "expected": [
        {
          "nodeId": "o",
          "configKey": "message",
          "path": "in.txt",
          "fields": [
            "raw",
            "text",
            "usage"
          ]
        }
      ]
    },
