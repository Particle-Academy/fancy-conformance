{
  "$schema": "../../../schema/case-table.schema.json",
  "suite": "shared/strings",
  "cases": [
    {
      "id": "0001-ascii-baseline",
      "title": "ASCII baseline — markers segment as expected",
      "since": "0.1.0",
      "tags": [
        "tokenize",
        "regression"
      ],
      "fn": "tokenizeInlineMarkdown",
      "input": {
        "text": "plain **bold** and `code` end"
      },
      "expected": [
        {
          "text": "plain ",
          "b": false,
          "i": false,
          "code": false
        },
        {
          "text": "bold",
          "b": true,
          "i": false,
          "code": false
        },
        {
          "text": " and ",
          "b": false,
          "i": false,
          "code": false
        },
        {
          "text": "code",
          "b": false,
          "i": false,
          "code": true
        },
        {
          "text": " end",
          "b": false,
          "i": false,
          "code": false
        }
      ],
      "notes": "The control. If this row fails, the implementation is broken generally rather than on Unicode specifically, and the rows below tell you nothing."
    },
    {
      "id": "0002-cjk-heading-text",
      "title": "CJK text around bold markers",
      "since": "0.1.0",
      "tags": [
        "tokenize",
        "cjk"
      ],
      "fn": "tokenizeInlineMarkdown",
      "input": {
        "text": "CJK 日本語の見出し **強調** です"
      },
      "expected": [
        {
          "text": "CJK 日本語の見出し ",
          "b": false,
          "i": false,
          "code": false
        },
        {
          "text": "強調",
          "b": true,
          "i": false,
          "code": false
        },
        {
          "text": " です",
          "b": false,
          "i": false,
          "code": false
        }
      ],
      "notes": "Multi-byte in UTF-8, single code unit in UTF-16. A byte-indexing implementation is safe here only because UTF-8 is self-synchronising — no continuation byte can collide with an ASCII marker."
    },
    {
      "id": "0003-accented-latin",
      "title": "Accented Latin around bold and code",
      "since": "0.1.0",
      "tags": [
        "tokenize",
        "latin1-supplement"
      ],
      "fn": "tokenizeInlineMarkdown",
      "input": {
        "text": "café **bold** and naïve `code`"
      },
      "expected": [
        {
          "text": "café ",
          "b": false,
          "i": false,
          "code": false
        },
        {
          "text": "bold",
          "b": true,
          "i": false,
          "code": false
        },
        {
          "text": " and naïve ",
          "b": false,
          "i": false,
          "code": false
        },
        {
          "text": "code",
          "b": false,
          "i": false,
          "code": true
        }
      ]
    },
    {
      "id": "0004-emoji-surrogate",
      "title": "Emoji (astral plane) around bold markers",
      "since": "0.1.0",
      "tags": [
        "tokenize",
        "emoji",
        "surrogate"
      ],
      "fn": "tokenizeInlineMarkdown",
      "input": {
        "text": "emoji 🎉 **bold** end"
      },
      "expected": [
        {
          "text": "emoji 🎉 ",
          "b": false,
          "i": false,
          "code": false
        },
        {
          "text": "bold",
          "b": true,
          "i": false,
          "code": false
        },
        {
          "text": " end",
          "b": false,
          "i": false,
          "code": false
        }
      ],
      "notes": "A surrogate PAIR in UTF-16, so the JS loop visits it as two separate iterations and reassembles it by appending both halves in order. Rust cannot inherit this: slicing &str at a non-char boundary panics rather than producing half a character."
    },
    {
      "id": "0005-combining-mark",
      "title": "Combining mark is not split from its base",
      "since": "0.1.0",
      "tags": [
        "tokenize",
        "combining"
      ],
      "fn": "tokenizeInlineMarkdown",
      "input": {
        "text": "á combining **mark** here"
      },
      "expected": [
        {
          "text": "á combining ",
          "b": false,
          "i": false,
          "code": false
        },
        {
          "text": "mark",
          "b": true,
          "i": false,
          "code": false
        },
        {
          "text": " here",
          "b": false,
          "i": false,
          "code": false
        }
      ],
      "notes": "U+0301 is a separate scalar value from its base letter. An implementation that segments by grapheme cluster rather than scalar will produce the same TEXT here but must not reorder or drop the mark."
    },
    {
      "id": "0006-marker-adjacent-cjk",
      "title": "Bold markers directly adjacent to CJK, no spaces",
      "since": "0.1.0",
      "tags": [
        "tokenize",
        "cjk",
        "edge"
      ],
      "fn": "tokenizeInlineMarkdown",
      "input": {
        "text": "日本語**強調**日本語"
      },
      "expected": [
        {
          "text": "日本語",
          "b": false,
          "i": false,
          "code": false
        },
        {
          "text": "強調",
          "b": true,
          "i": false,
          "code": false
        },
        {
          "text": "日本語",
          "b": false,
          "i": false,
          "code": false
        }
      ],
      "notes": "No ASCII whitespace anywhere near the markers. This is the row that fails first if an implementation looks backward or forward one BYTE to decide whether a marker is word-adjacent."
    },
    {
      "id": "0007-emoji-inside-code",
      "title": "Emoji and accents inside a code span",
      "since": "0.1.0",
      "tags": [
        "tokenize",
        "emoji",
        "code-span"
      ],
      "fn": "tokenizeInlineMarkdown",
      "input": {
        "text": "x `🎉 café` y"
      },
      "expected": [
        {
          "text": "x ",
          "b": false,
          "i": false,
          "code": false
        },
        {
          "text": "🎉 café",
          "b": false,
          "i": false,
          "code": true
        },
        {
          "text": " y",
          "b": false,
          "i": false,
          "code": false
        }
      ],
      "notes": "Code spans are copied out by index rather than scanned character by character, so this exercises the slice path instead of the append path."
    },
    {
      "id": "0008-unclosed-code",
      "title": "Unclosed code span swallows the rest, including non-ASCII",
      "since": "0.1.0",
      "tags": [
        "tokenize",
        "edge",
        "fail-open"
      ],
      "fn": "tokenizeInlineMarkdown",
      "input": {
        "text": "trailing `unclosed 日本語"
      },
      "expected": [
        {
          "text": "trailing ",
          "b": false,
          "i": false,
          "code": false
        },
        {
          "text": "`unclosed 日本語",
          "b": false,
          "i": false,
          "code": false
        }
      ],
      "notes": "An unterminated backtick falls through as literal text rather than erroring. The remainder is taken as one slice to end-of-string, so a byte-indexed implementation must land on a char boundary."
    },
    {
      "id": "0009-escaped-bold-markers",
      "title": "Escaped asterisks are literal and lose their backslash",
      "since": "0.36.0",
      "tags": [
        "tokenize",
        "escape",
        "regression"
      ],
      "fn": "tokenizeInlineMarkdown",
      "input": {
        "text": "\\*\\*not bold\\*\\*"
      },
      "expected": [
        {
          "text": "**not bold**",
          "b": false,
          "i": false,
          "code": false
        }
      ],
      "notes": "CommonMark backslash escape. Before the fix that added this row, all three dark-slide engines printed the backslash AND the asterisk still opened emphasis."
    },
    {
      "id": "0010-escaped-backticks",
      "title": "Escaped backticks do not open a code span",
      "since": "0.36.0",
      "tags": [
        "tokenize",
        "escape",
        "regression"
      ],
      "fn": "tokenizeInlineMarkdown",
      "input": {
        "text": "\\`not code\\` and `code`"
      },
      "expected": [
        {
          "text": "`not code` and ",
          "b": false,
          "i": false,
          "code": false
        },
        {
          "text": "code",
          "b": false,
          "i": false,
          "code": true
        }
      ],
      "notes": "An escaped backtick is a literal backtick; the unescaped pair after it still makes a code span."
    },
    {
      "id": "0011-escaped-backslash",
      "title": "An escaped backslash does not escape what follows it",
      "since": "0.36.0",
      "tags": [
        "tokenize",
        "escape",
        "edge"
      ],
      "fn": "tokenizeInlineMarkdown",
      "input": {
        "text": "\\\\*x*"
      },
      "expected": [
        {
          "text": "\\",
          "b": false,
          "i": false,
          "code": false
        },
        {
          "text": "x",
          "b": false,
          "i": true,
          "code": false
        }
      ],
      "notes": "Two backslashes are one literal backslash, and the asterisk after them is a live marker. An implementation that only looks one character back to decide whether a marker is escaped gets this wrong."
    },
    {
      "id": "0012-backslash-before-non-punctuation",
      "title": "A backslash before a letter, a space, non-ASCII or the end is literal",
      "since": "0.36.0",
      "tags": [
        "tokenize",
        "escape",
        "edge"
      ],
      "fn": "tokenizeInlineMarkdown",
      "input": {
        "text": "C:\\path, a \\ b, \\é and end\\"
      },
      "expected": [
        {
          "text": "C:\\path, a \\ b, \\é and end\\",
          "b": false,
          "i": false,
          "code": false
        }
      ],
      "notes": "Only ASCII punctuation is escapable. Before a UTF-8 lead byte (PHP), a UTF-16 unit (Node) or a codepoint (Python) above 127 the backslash stays, so the three index schemes still agree."
    },
    {
      "id": "0013-backslash-inside-code-span",
      "title": "Nothing is an escape inside a code span",
      "since": "0.36.0",
      "tags": [
        "tokenize",
        "escape",
        "code-span"
      ],
      "fn": "tokenizeInlineMarkdown",
      "input": {
        "text": "`a\\*b` and **x \\* y**"
      },
      "expected": [
        {
          "text": "a\\*b",
          "b": false,
          "i": false,
          "code": true
        },
        {
          "text": " and ",
          "b": false,
          "i": false,
          "code": false
        },
        {
          "text": "x * y",
          "b": true,
          "i": false,
          "code": false
        }
      ],
      "notes": "The code span is sliced raw, so its backslash stays; the escaped asterisk inside bold is literal and does not close it."
    },
    {
      "id": "0014-every-ascii-punctuation",
      "title": "Every ASCII punctuation character is escapable",
      "since": "0.36.0",
      "tags": [
        "tokenize",
        "escape"
      ],
      "fn": "tokenizeInlineMarkdown",
      "input": {
        "text": "\\!\\\"\\#\\$\\%\\&\\'\\(\\)\\*\\+\\,\\-\\.\\/\\:\\;\\<\\=\\>\\?\\@\\[\\\\\\]\\^\\_\\`\\{\\|\\}\\~"
      },
      "expected": [
        {
          "text": "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~",
          "b": false,
          "i": false,
          "code": false
        }
      ],
      "notes": "All 32 characters of CommonMark's ASCII punctuation set, each escaped once. The output is the set itself, with no backslash left over but the one that was escaped."
    }
  ]
}
