      "input": {
        "expression": "in.content",
        "context": {
          "in": {
            "content": "hello",
            "count": 3,
            "deal_id": "D-1",
            "transcript": null,
            "items": [
              1,
              2
            ],
            "empty": [],
            "obj": {},
            "flag": true,
            "zero": 0,
            "blank": ""
          },
          "user": {
