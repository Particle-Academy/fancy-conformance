    {
      "id": "0901-array-length",
      "title": "`.length` counts an array.",
      "since": "0.15.0",
      "tags": [
        "expr",
        "length"
      ],
      "input": {
        "expression": "in.items.length",
        "context": {
          "in": {
            "content": "hello",
            "count": 3,
            "deal_id": "D-1",
            "transcript": null,
            "items": [
              1,
