    {
      "id": "0010-group-xp-truncates-per-metric",
      "title": "weighted group XP truncates each metric before summing",
      "tags": ["groups", "hazard"],
      "fn": "scenario",
      "notes": "Two metrics at weight 0.5 with 7 XP each: int(3.5) + int(3.5) = 6, not int(7) = 7 and not round(3.5) * 2 = 8. Group level 3 needs 7, so a twin that sums first reports level 3 here.",
      "input": {
        "clock": "2026-11-18T12:00:00+00:00",
        "subjects": { "ada": "user" },
        "steps": [
          { "op": "setup", "a": "gamed-metric", "with": { "slug": "combat" } },
          { "op": "setup", "a": "gamed-metric", "with": { "slug": "crafting" } },
          { "op": "setup", "a": "metric-level-group", "with": { "slug": "power" } },
          { "op": "setup", "a": "metric-level-group-metric", "with": { "group": "power", "metric": "combat", "weight": 0.5 } },
          { "op": "setup", "a": "metric-level-group-metric", "with": { "group": "power", "metric": "crafting", "weight": 0.5 } },
          { "op": "setup", "a": "metric-level-group-level", "with": { "group": "power", "level": 1, "xp": 0 } },
          { "op": "setup", "a": "metric-level-group-level", "with": { "group": "power", "level": 2, "xp": 6 } },
          { "op": "setup", "a": "metric-level-group-level", "with": { "group": "power", "level": 3, "xp": 7 } },
          { "op": "award", "metric": "combat", "to": "ada", "amount": 7 },
          { "op": "award", "metric": "crafting", "to": "ada", "amount": 7 },
          { "op": "levelInfo", "who": "ada", "group": "power" },
          { "op": "hasLevel", "who": "ada", "level": 3, "group": "power" },
          { "op": "hasLevel", "who": "ada", "level": 2, "group": "power" },
          { "op": "profile", "who": "ada" }
        ]
      }
    },
