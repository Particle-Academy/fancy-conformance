    {
      "id": "0012-progress-from-the-level-floor",
      "title": "progress is measured from the current level's floor, not from zero",
      "tags": ["levels", "hazard", "canon-4.8"],
      "fn": "scenario",
      "notes": "Levels at 0, 100 and 300; 200 XP is level 2, and halfway from 100 to 300: 50.0, not 66.67 (200/300). At the top level progress is 100.0 and the next threshold null. The gamification canon's 4.8 records the UI shipping the wrong one of these once.",
      "input": {
        "clock": "2026-11-18T12:00:00+00:00",
        "subjects": { "ada": "user", "bo": "user", "cy": "user" },
        "steps": [
          { "op": "setup", "a": "gamed-metric", "with": { "slug": "combat" } },
          { "op": "setup", "a": "metric-level", "with": { "metric": "combat", "level": 1, "xp": 0 } },
          { "op": "setup", "a": "metric-level", "with": { "metric": "combat", "level": 2, "xp": 100 } },
