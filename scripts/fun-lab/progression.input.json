    },
    {
      "id": "0006-award-amount-guards",
      "title": "amount 0 and a negative amount are refused; the cap is inclusive",
      "tags": ["award", "guards", "hazard"],
      "fn": "scenario",
      "notes": "With a cap of 100, 100 is allowed and 101 is refused as cap_exceeded. Catches an off-by-one cap and a twin that accepts 0 as a no-op.",
      "input": {
        "clock": "2026-11-18T12:00:00+00:00",
        "config": { "max_points_per_action": 100 },
        "subjects": { "ada": "user" },
        "steps": [
          { "op": "setup", "a": "gamed-metric", "with": { "slug": "combat" } },
          { "op": "award", "metric": "combat", "to": "ada", "amount": 0 },
          { "op": "award", "metric": "combat", "to": "ada", "amount": -5 },
          { "op": "award", "metric": "combat", "to": "ada", "amount": 101 },
          { "op": "award", "metric": "combat", "to": "ada", "amount": 100 },
          { "op": "profile", "who": "ada" }
        ]
      }
    },
