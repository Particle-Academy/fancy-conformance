        "subjects": { "ada": "user" },
        "steps": [
          { "op": "setup", "a": "gamed-metric", "with": { "slug": "Combat XP" } },
          { "op": "clock", "at": "2026-11-18T13:00:00+00:00" },
          { "op": "setup", "a": "gamed-metric", "with": { "slug": "combat_xp", "description": "Fighting" } },
          { "op": "setup", "a": "metric-level", "with": { "metric": "combat-xp", "level": 2, "xp": 100 } },
          { "op": "setup", "a": "metric-level", "with": { "metric": "combat-xp", "level": 2, "xp": 150, "name": "Brawler" } },
          { "op": "setup", "a": "achievement", "with": { "slug": "first_login", "icon": "star", "hidden": true, "order": 3, "metadata": { "tier": "bronze" } } },
          { "op": "setup", "a": "prize", "with": { "slug": "Free Month", "type": "feature_unlock", "cost": 500, "inventory": 10 } },
          { "op": "catalog" }
        ]
      }
