          { "op": "award", "metric": "combat", "to": "ada", "amount": 200 },
          { "op": "award", "metric": "combat", "to": "bo", "amount": 999 },
          { "op": "levelInfo", "who": "ada", "metric": "combat" },
          { "op": "levelInfo", "who": "bo", "metric": "combat" },
          { "op": "levelInfo", "who": "cy", "metric": "combat" },
          { "op": "award", "metric": "combat", "to": "cy", "amount": 30 },
          { "op": "levelInfo", "who": "cy", "metric": "combat" }
        ]
      }
    },
