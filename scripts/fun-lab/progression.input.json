{
  "suite": "fun-lab/progression",
  "manifest": {
    "title": "fun-lab: catalog setup, XP awards, metric and group level progression",
    "since": "0.49.0",
    "caseFormat": "table",
    "contract": {
      "summary": "A scenario: a frozen clock, named subjects and a list of steps (setup, attach, award, grant, opt-out, clock moves, level reads), run through the engine. Expected is, per step, the step's result (or its refusal) and the events it emitted, in order. Covers upsert-by-slug setup and its validation, the XP award guards (amount, per-action cap, unknown or inactive metric, opt-out), levels claimed exactly once in ascending order with their attached achievements, weighted group XP, hasLevel and progress measured from the current level's floor.",
      "functions": {
        "scenario": "scenario(input: {clock, config?, subjects, steps}) -> {steps: [{result, events}]}. Subjects are named; awardable ids are 1, 2, 3 in listed order and types are reported by their scenario names."
      },
      "reference": "php",
      "referenceNote": "Goldens are laravel-fun-lab's own engine (0.8.0 and later, with period boards on the event log and compare-and-set group levels) driven through its public API by tests/Conformance/ScenarioRunner.php and written by tests/Conformance/ExportFixturesTest.php. Inputs are authored in fancy-conformance/scripts/fun-lab/progression.input.json.",
      "implementations": [
        { "language": "php", "package": "particle-academy/laravel-fun-lab", "symbol": "LaravelFunLab\\Facades\\LFL" },
        { "language": "node", "package": "@particle-academy/fancy-fun-lab", "symbol": "FunLab" },
        { "language": "python", "package": "fancy-fun-lab", "symbol": "fancy_fun_lab.FunLab" }
      ]
    },
    "notes": "No discrimination probes: the implementation under test is a whole gamification engine, which this package does not carry, as with flow/graph-runs. These rows guard drift between three runtimes; the hazard rows name in their notes the wrong answer each exists to catch."
  },
  "cases": [
    {
      "id": "0001-award-below-the-first-threshold",
      "title": "an award below level 2 creates the profile at level 1 and emits only xp.awarded",
      "tags": ["award", "control"],
      "fn": "scenario",
      "input": {
        "clock": "2026-11-18T12:00:00+00:00",
        "subjects": { "ada": "user" },
        "steps": [
          { "op": "setup", "a": "gamed-metric", "with": { "slug": "combat" } },
          { "op": "setup", "a": "metric-level", "with": { "metric": "combat", "level": 1, "xp": 0 } },
          { "op": "setup", "a": "metric-level", "with": { "metric": "combat", "level": 2, "xp": 100 } },
          { "op": "award", "metric": "combat", "to": "ada", "amount": 50, "reason": "first blood", "source": "arena" },
          { "op": "profile", "who": "ada" }
        ]
      }
    },
    {
      "id": "0002-one-award-crosses-three-levels",
      "title": "one award crossing three levels emits three level-reached events, ascending",
      "tags": ["levels", "hazard"],
      "fn": "scenario",
      "notes": "Catches a twin that announces only the highest level reached, or announces them highest first. One award, three events, in order 2, 3, 4.",
      "input": {
        "clock": "2026-11-18T12:00:00+00:00",
        "subjects": { "ada": "user" },
        "steps": [
          { "op": "setup", "a": "gamed-metric", "with": { "slug": "combat" } },
          { "op": "setup", "a": "metric-level", "with": { "metric": "combat", "level": 1, "xp": 0 } },
          { "op": "setup", "a": "metric-level", "with": { "metric": "combat", "level": 2, "xp": 100 } },
          { "op": "setup", "a": "metric-level", "with": { "metric": "combat", "level": 3, "xp": 200 } },
          { "op": "setup", "a": "metric-level", "with": { "metric": "combat", "level": 4, "xp": 300 } },
          { "op": "award", "metric": "combat", "to": "ada", "amount": 350 },
          { "op": "award", "metric": "combat", "to": "ada", "amount": 10 }
        ]
      }
    },
    {
      "id": "0003-level-achievement-granted-on-crossing",
      "title": "an achievement attached to a level is granted when the level is reached, once",
      "tags": ["levels", "achievements"],
      "fn": "scenario",
      "notes": "The level-reached event carries only the achievements granted on that crossing; a later award past the same level grants nothing again.",
      "input": {
        "clock": "2026-11-18T12:00:00+00:00",
        "subjects": { "ada": "user" },
        "steps": [
          { "op": "setup", "a": "gamed-metric", "with": { "slug": "combat" } },
          { "op": "setup", "a": "metric-level", "with": { "metric": "combat", "level": 2, "xp": 100, "name": "Apprentice" } },
          { "op": "setup", "a": "metric-level", "with": { "metric": "combat", "level": 3, "xp": 200, "name": "Adept" } },
          { "op": "setup", "a": "achievement", "with": { "slug": "adept", "description": "Reached Adept" } },
          { "op": "attach", "achievement": "adept", "metricLevel": { "metric": "combat", "level": 3 } },
          { "op": "award", "metric": "combat", "to": "ada", "amount": 150 },
          { "op": "award", "metric": "combat", "to": "ada", "amount": 60 },
          { "op": "award", "metric": "combat", "to": "ada", "amount": 500 },
          { "op": "profile", "who": "ada" }
        ]
      }
    },
    {
      "id": "0004-held-achievement-is-skipped",
      "title": "an achievement already held is skipped on crossing, not re-granted and not an error",
      "tags": ["levels", "achievements", "hazard"],
      "fn": "scenario",
      "notes": "The level-reached event's achievements list is empty, and there is no second achievement.unlocked.",
      "input": {
        "clock": "2026-11-18T12:00:00+00:00",
        "subjects": { "ada": "user" },
        "steps": [
          { "op": "setup", "a": "gamed-metric", "with": { "slug": "combat" } },
          { "op": "setup", "a": "metric-level", "with": { "metric": "combat", "level": 2, "xp": 100 } },
          { "op": "setup", "a": "achievement", "with": { "slug": "veteran" } },
          { "op": "attach", "achievement": "veteran", "metricLevel": { "metric": "combat", "level": 2 } },
          { "op": "grant", "slug": "veteran", "to": "ada", "reason": "imported" },
          { "op": "award", "metric": "combat", "to": "ada", "amount": 100 },
          { "op": "profile", "who": "ada" }
        ]
      }
    },
